/* Frontier theme (DM) for the Genesis PCG Rocks and Cliffs studio + the Genesis Studio Strata host.
   Warm gunmetal panels, orange accent, gold primary buttons, cut corners. Loaded after Assets/_Project/Editor/GenesisTheme/*.uss. */
.dm-frontier,
.pcg-studio.dm-frontier,
.dm-frontier .pcg-studio {
    --pcg-bg-0: #0f0e0c;
    --pcg-bg-1: #171512;
    --pcg-bg-2: #201d19;
    --pcg-bg-3: #2a2620;
    --pcg-line: #3d372e;
    --pcg-accent: #ff8a2a;
    --pcg-primary: #ffc23d;
    --pcg-primary-text: #0f0e0c;
    --pcg-text: #e8e0d2;
    --pcg-text-dim: #9b9182;
}

/* Strata host (third tab level) */
.dm-strata { background-color: #0f0e0c; padding: 0; }
.dm-strata__crumb { color: #9b9182; font-size: 10px; letter-spacing: 2px; margin: 4px 10px 2px 10px; }
.dm-strata__tabs { flex-direction: row; padding: 2px 10px 6px 10px; border-bottom-width: 1px; border-bottom-color: #3d372e; }
.dm-strata__tab {
    height: 24px; padding: 0 14px; margin: 0 6px 0 0; color: #9b9182; -unity-font-style: bold; letter-spacing: 1px;
    background-color: rgba(0,0,0,0); border-width: 0; border-radius: 0;
    --pcg-cut: 7; --pcg-cut-fill: #171512; --pcg-cut-line: #3d372e; --pcg-cut-line-width: 1;
}
.dm-strata__tab:hover { color: #e8e0d2; --pcg-cut-line: #ff8a2a; }
.dm-strata__tab--selected { color: #ff8a2a; --pcg-cut-fill: #2a2620; --pcg-cut-line: #ff8a2a; }
.dm-strata__content { flex-grow: 1; }

/* Cut-corner surfaces (drawn by PcgCutCorners from these properties) */
.dm-frontier .pcg-card {
    background-color: rgba(0,0,0,0); border-width: 0;
    --pcg-cut: 12; --pcg-cut-fill: #171512; --pcg-cut-line: #3d372e; --pcg-cut-line-width: 1;
}
.dm-frontier .pcg-card__title { color: #ff8a2a; letter-spacing: 2px; }
.dm-frontier .pcg-card--placeholder { --pcg-cut-line: #ff8a2a; }
.dm-frontier .pcg-card--library { --pcg-cut-fill: #141210; }

.dm-frontier .pcg-tab, .dm-frontier .pcg-btn {
    background-color: rgba(0,0,0,0); border-width: 0;
    --pcg-cut: 7; --pcg-cut-fill: #2a2620; --pcg-cut-line: #3d372e; --pcg-cut-line-width: 1;
}
.dm-frontier .pcg-tab { --pcg-cut-fill: #171512; }
.dm-frontier .pcg-tab:hover, .dm-frontier .pcg-btn:hover { --pcg-cut-line: #ff8a2a; color: #ff8a2a; }
.dm-frontier .pcg-btn:active { --pcg-cut-fill: #201d19; }
.dm-frontier .pcg-tab--selected { color: #ff8a2a; --pcg-cut-fill: #2a2620; --pcg-cut-line: #ff8a2a; border-bottom-width: 0; }
.dm-frontier .pcg-btn-primary { color: #0f0e0c; --pcg-cut-fill: #ffc23d; --pcg-cut-line: #ffc23d; -unity-font-style: bold; }
.dm-frontier .pcg-btn-primary:hover { color: #0f0e0c; --pcg-cut-fill: #ffd36e; --pcg-cut-line: #ff8a2a; }
.dm-frontier .pcg-btn:disabled { opacity: 0.45; }

.dm-frontier .pcg-dropzone {
    background-color: rgba(0,0,0,0); border-width: 0;
    --pcg-cut: 10; --pcg-cut-fill: #0f0e0c; --pcg-cut-line: #3d372e; --pcg-cut-line-width: 1;
}
.dm-frontier .pcg-dropzone--hover { --pcg-cut-line: #ff8a2a; --pcg-cut-fill: #201d19; }

.dm-frontier .pcg-tile {
    background-color: rgba(0,0,0,0); border-width: 0;
    --pcg-cut: 9; --pcg-cut-fill: #201d19; --pcg-cut-line: #3d372e; --pcg-cut-line-width: 1;
}
.dm-frontier .pcg-tile:hover { --pcg-cut-line: #ff8a2a; }
.dm-frontier .pcg-tile--selected { --pcg-cut-line: #ffc23d; --pcg-cut-fill: #2a2620; }
.dm-frontier .pcg-tile__icon { background-color: #0f0e0c; }

.dm-frontier .pcg-iconview { border-color: #3d372e; background-color: #201d19; --pcg-cut: 0; }
.dm-frontier .pcg-iconview:focus { border-color: #ff8a2a; }
.dm-frontier .pcg-source--base { border-left-color: #ff8a2a; background-color: #201d19; }
.dm-frontier .pcg-status { color: #ffc23d; }

/* Inputs */
.dm-frontier .unity-base-field__input, .dm-frontier .unity-base-popup-field__input, .dm-frontier .unity-text-field__input {
    background-color: #0f0e0c; border-color: #3d372e; border-radius: 0; color: #e8e0d2;
}
.dm-frontier .unity-base-field__input:hover, .dm-frontier .unity-base-popup-field__input:hover { border-color: #ff8a2a; }
.dm-frontier .unity-toggle__checkmark { background-color: #0f0e0c; border-color: #3d372e; border-radius: 0; }
.dm-frontier .unity-toggle:checked .unity-toggle__checkmark { -unity-background-image-tint-color: #ff8a2a; border-color: #ff8a2a; }
.dm-frontier .unity-base-slider__tracker { background-color: #2a2620; border-color: #3d372e; }
.dm-frontier .unity-base-slider__dragger { background-color: #ff8a2a; border-color: #ff8a2a; border-radius: 0; }
