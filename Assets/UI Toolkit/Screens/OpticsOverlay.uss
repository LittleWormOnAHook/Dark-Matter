.dmg-optics-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
}

.dmg-optics-viewport {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgb(0, 0, 0);
    -unity-background-scale-mode: stretch-to-fill;
}

.dmg-optics-dim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.55);
    -unity-background-scale-mode: stretch-to-fill;
}

.dmg-optics-binocular,
.dmg-optics-scanner {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
}

.dmg-optics-scope-outer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(8, 12, 18, 0.35);
    -unity-background-scale-mode: scale-to-fit;
}

.dmg-optics-scope-inner {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 680px;
    height: 680px;
    margin-left: -340px;
    margin-top: -340px;
    background-color: rgba(230, 242, 255, 0.08);
    -unity-background-scale-mode: scale-to-fit;
}

.dmg-optics-crosshair-h {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 28px;
    height: 2px;
    margin-left: -14px;
    margin-top: -1px;
    background-color: rgb(237, 233, 228);
}

.dmg-optics-crosshair-v {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 2px;
    height: 28px;
    margin-left: -1px;
    margin-top: -14px;
    background-color: rgb(237, 233, 228);
}

.dmg-optics-scanner-border {
    position: absolute;
    background-color: rgba(0, 0, 0, 0);
}

.dmg-optics-scanner-border-top {
    left: 0;
    top: 0;
    right: 0;
    height: 30px;
    /* UITK does not support CSS linear-gradient as background-image (spams console). */
    background-color: rgba(107, 199, 122, 0.28);
}

.dmg-optics-scanner-border-bottom {
    left: 0;
    right: 0;
    bottom: 0;
    height: 30px;
    background-color: rgba(107, 199, 122, 0.28);
}

.dmg-optics-scanner-border-left {
    left: 0;
    top: 0;
    bottom: 0;
    width: 30px;
    background-color: rgba(107, 199, 122, 0.28);
}

.dmg-optics-scanner-border-right {
    top: 0;
    right: 0;
    bottom: 0;
    width: 30px;
    background-color: rgba(107, 199, 122, 0.28);
}

.dmg-optics-markers {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
}

.dmg-optics-marker {
    position: absolute;
    width: 18px;
    height: 18px;
    background-color: rgb(140, 255, 217);
    border-radius: 9px;
}

.dmg-optics-marker-label {
    position: absolute;
    left: 22px;
    top: -4px;
    width: 160px;
    height: 24px;
    font-size: 14px;
    color: rgb(140, 255, 217);
    -unity-text-align: middle-left;
}

.dmg-optics-mode {
    position: absolute;
    left: 50%;
    top: 8%;
    width: 640px;
    height: 36px;
    margin-left: -320px;
    font-size: 22px;
    color: rgb(217, 242, 255);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.dmg-optics-hint {
    position: absolute;
    left: 50%;
    bottom: 5%;
    width: 640px;
    height: 36px;
    margin-left: -320px;
    font-size: 20px;
    color: rgb(253, 181, 74);
    -unity-text-align: middle-center;
}

.dmg-optics-range {
    position: absolute;
    left: 50%;
    bottom: 10%;
    width: 420px;
    height: 28px;
    margin-left: -210px;
    font-size: 16px;
    color: rgb(237, 233, 228);
    -unity-text-align: middle-center;
}

.dmg-optics-scanning {
    position: absolute;
    left: 50%;
    top: 18%;
    width: 420px;
    height: 64px;
    margin-left: -210px;
    font-size: 36px;
    color: rgb(212, 160, 23);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}
