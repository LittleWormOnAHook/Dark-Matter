/* DMUiToolkit 0901-finish */
.dmg-wm-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    -unity-font-definition: url("project://database/Assets/Shift%20-%20Complete%20Sci-Fi%20UI/Fonts/Rajdhani-Regular.ttf?fileID=12800000&guid=11524516bb0f95d4ba72a86cdd3756e0&type=3#Rajdhani-Regular");
}

.dmg-wm-modal {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
}

.dmg-hi-veil {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.35);
}

.dmg-gs-veil {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.72);
}

.dmg-hi-panel {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 280px;
    margin-left: -140px;
    margin-top: -170px;
    padding: 16px 18px;
    background-color: rgba(28, 42, 56, 0.96);
    border-width: 1px;
    border-color: rgb(192, 46, 122);
    align-items: center;
    flex-direction: column;
}

.dmg-hi-title {
    height: 32px;
    font-size: 22px;
    color: rgb(237, 233, 228);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Shift%20-%20Complete%20Sci-Fi%20UI/Fonts/Rajdhani-SemiBold.ttf?fileID=12800000&guid=28b6d07166d6d8947a6671e5480cbf66&type=3#Rajdhani-SemiBold");
}

.dmg-hi-body {
    height: 24px;
    margin-bottom: 8px;
    font-size: 16px;
    color: rgb(140, 127, 117);
    -unity-text-align: middle-center;
}

.dmg-hi-btn {
    width: 220px;
    height: 40px;
    margin-top: 8px;
    background-color: rgba(192, 46, 122, 0.95);
    color: rgb(237, 233, 228);
    font-size: 17px;
    -unity-font-style: bold;
}

.dmg-hi-btn-muted {
    height: 34px;
    background-color: rgba(74, 74, 90, 0.82);
    font-size: 15px;
}

.dmg-wm-dialog {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 420px;
    margin-left: -210px;
    margin-top: -160px;
    padding: 18px 20px;
    background-color: rgba(28, 42, 56, 0.96);
    border-width: 1px;
    border-color: rgb(192, 46, 122);
    align-items: center;
    flex-direction: column;
}

.dmg-wm-echo {
    width: 560px;
    margin-left: -280px;
    margin-top: -200px;
}

.dmg-wm-dialog-body {
    width: 100%;
    min-height: 80px;
    margin-top: 8px;
    margin-bottom: 8px;
    font-size: 16px;
    color: rgb(237, 233, 228);
    white-space: normal;
}

.dmg-wm-kicker {
    font-size: 14px;
    color: rgb(212, 160, 23);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.dmg-wm-weapon-panel {
    left: 50%;
    top: 50%;
    margin-left: -110px;
    margin-top: -80px;
}

.dmg-wm-scan {
    position: absolute;
    left: 50%;
    top: 42%;
    width: 360px;
    height: 56px;
    margin-left: -180px;
    background-color: rgba(28, 42, 56, 0.94);
    border-width: 1px;
    border-color: rgb(212, 160, 23);
    align-items: center;
    justify-content: center;
}

.dmg-wm-scan-name {
    font-size: 24px;
    color: rgb(212, 160, 23);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Shift%20-%20Complete%20Sci-Fi%20UI/Fonts/Rajdhani-SemiBold.ttf?fileID=12800000&guid=28b6d07166d6d8947a6671e5480cbf66&type=3#Rajdhani-SemiBold");
}

.dmg-wm-tame {
    position: absolute;
    width: 180px;
    height: 28px;
    left: 0;
    top: 0;
}

.dmg-wm-tame-bg {
    width: 100%;
    height: 14px;
    background-color: rgba(28, 42, 56, 0.92);
    border-width: 1px;
    border-color: rgb(74, 74, 90);
}

.dmg-wm-tame-fill {
    height: 100%;
    width: 40%;
    background-color: rgb(192, 46, 122);
}

.dmg-wm-tame-label {
    width: 100%;
    height: 14px;
    font-size: 12px;
    color: rgb(212, 160, 23);
    -unity-text-align: middle-center;
}

.dmg-pioneer-hover {
    position: absolute;
    flex-direction: row;
    align-items: flex-start;
    min-width: 400px;
    max-width: 560px;
    padding: 12px;
    background-color: rgba(61, 52, 69, 0.96);
    border-width: 1px;
    border-color: rgb(192, 46, 122);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}
.dmg-pioneer-hover-ring {
    width: 160px;
    height: 160px;
    min-width: 160px;
    margin-right: 12px;
    padding: 4px;
    border-width: 3px;
    border-color: rgb(169, 228, 247);
    border-top-left-radius: 80px;
    border-top-right-radius: 80px;
    border-bottom-left-radius: 80px;
    border-bottom-right-radius: 80px;
    background-color: rgb(28, 42, 56);
}
.dmg-pioneer-hover-portrait {
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-width: 2px;
    border-color: rgb(169, 228, 247);
    border-top-left-radius: 76px;
    border-top-right-radius: 76px;
    border-bottom-left-radius: 76px;
    border-bottom-right-radius: 76px;
    -unity-background-scale-mode: scale-to-fit;
}
.dmg-pioneer-hover-initials {
    width: 100%;
    height: 100%;
    color: rgb(237, 233, 228);
    font-size: 42px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.dmg-pioneer-hover-text {
    flex-grow: 1;
    flex-direction: column;
    min-width: 240px;
}
.dmg-pioneer-hover-title {
    color: rgb(182, 168, 222);
    font-size: 18px;
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 4px;
}
.dmg-pioneer-hover-body {
    color: rgb(212, 160, 23);
    font-size: 13px;
    white-space: normal;
}
