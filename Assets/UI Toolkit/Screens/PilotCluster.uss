/* Symmetric lower-right cluster. No panel. Map texture only in the circle. */
.pilot-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    -unity-font-definition: url("project://database/Assets/Shift%20-%20Complete%20Sci-Fi%20UI/Fonts/Rajdhani-Regular.ttf?fileID=12800000&guid=11524516bb0f95d4ba72a86cdd3756e0&type=3#Rajdhani-Regular");
}

.pilot-cluster {
    position: absolute;
    left: 4px;
    bottom: 4px;
    width: 248px;
    height: 290px;
    background-color: rgba(0, 0, 0, 0);
    overflow: visible;
}

.pilot-kicker {
    color: #D4A017;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0);
    margin-bottom: 0;
}

.pilot-stat-value {
    color: #EDE9E4;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0);
}

.pilot-corner-block {
    position: absolute;
    top: 4px;
    width: 70px;
    background-color: rgba(0, 0, 0, 0);
    align-items: center;
}

.pilot-energy-block { left: 4px; }
.pilot-stamina-block { right: 4px; }
.pilot-energy-value { color: #D4A017; }
.pilot-stamina-value { color: rgb(107, 199, 122); }

.pilot-side-block {
    position: absolute;
    left: 50%;
    top: 198px;
    width: 56px;
    margin-left: -28px;
    background-color: rgba(0, 0, 0, 0);
    align-items: center;
}

.pilot-o2-block { left: 50%; }

.pilot-o2-icon {
    color: #EDE9E4;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0);
}

.pilot-o2-value {
    color: #EDE9E4;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0);
}

.pilot-health {
    /* +25% again from 40px host / 10px track; bottom-aligned with temperature strip. */
    position: absolute;
    right: 0px;
    bottom: 4px;
    top: auto;
    width: 50px;
    height: 186px;
    align-items: center;
    justify-content: flex-end;
    background-color: rgba(0, 0, 0, 0);
}

.pilot-health-track {
    width: 13px;
    flex-grow: 1;
    margin-top: 0;
    margin-bottom: 2px;
    background-color: rgba(28, 42, 56, 0.35);
    justify-content: flex-end;
    overflow: hidden;
    border-width: 1px;
    border-color: #8A6A12;
}

.pilot-health-fill {
    /* Solid fill replaced at runtime by dashed HealthDashes painter. Keep host for Builder. */
    width: 100%;
    height: 100%;
    background-color: rgb(232, 59, 59);
}

.pilot-health-value {
    color: #EDE9E4;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0);
    margin-bottom: 2px;
}

.pilot-map-stage {
    position: absolute;
    left: 4px;
    top: 48px;
    width: 200px;
    height: 200px;
    background-color: rgba(0, 0, 0, 0);
}

.pilot-arcs {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
}

.pilot-map-ring {
    position: absolute;
    left: 16px;
    top: 16px;
    width: 168px;
    height: 168px;
    border-width: 2px;
    border-color: #D4A017;
    border-radius: 84px;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0);
}

.pilot-map-view {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    border-radius: 84px;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-and-crop;
}

.pilot-map-player {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 14px;
    height: 14px;
    margin-left: -7px;
    margin-top: -7px;
    background-color: rgba(0, 0, 0, 0);
}

.pilot-cardinal {
    position: absolute;
    color: #FF1E14;
    font-size: 13px; /* 11px + 20% */
    -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-center;
}

.pilot-cardinal-n { left: 50%; top: -2px; margin-left: -6px; color: #FF1E14; }
.pilot-cardinal-e { left: auto; right: -2px; top: 50%; margin-top: -8px; color: #FF1E14; }
.pilot-cardinal-s { left: 50%; top: auto; bottom: -2px; margin-left: -6px; color: #FF1E14; }
.pilot-cardinal-w { left: -2px; top: 50%; margin-top: -8px; color: #FF1E14; }

.pilot-pois {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);
}

.pilot-poi {
    position: absolute;
    width: 6px;
    height: 6px;
    margin-left: -3px;
    margin-top: -3px;
    background-color: #C02E7A;
    border-radius: 3px;
}

.pilot-top-meta {
    /* Centered on player arrow / map ring: map-stage left 4 + width 200 → center 104 inside cluster. */
    position: absolute;
    left: 104px;
    top: 0px;
    width: 200px;
    height: 28px;
    margin-left: -100px;
    align-items: stretch;
    background-color: rgba(0, 0, 0, 0);
}

.pilot-top-meta .pilot-meta-line {
    width: 100%;
    -unity-text-align: middle-center;
    font-size: 12px;
    height: 14px;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
}

.pilot-top-meta .pilot-grid {
    margin-top: -4px;
}

.pilot-temp-gauge {
    position: absolute;
    left: 24px;
    top: 252px;
    width: 160px;
    height: 34px;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
}

.pilot-temp-track {
    width: 148px;
    height: 8px;
    margin-top: 2px;
    background-color: rgba(0, 0, 0, 0);
    overflow: hidden;
    border-radius: 1px;
}

.pilot-temp-value {
    color: #EDE9E4;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 0.4px;
    -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0);
    margin-top: 2px;
}

.pilot-meta-col {
    position: absolute;
    top: 238px;
    width: 110px;
    background-color: rgba(0, 0, 0, 0);
}

.pilot-left-meta { left: 4px; align-items: flex-start; }
.pilot-right-meta { right: 4px; align-items: flex-end; }

.pilot-meta-line {
    color: #EDE9E4;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 0.4px;
    background-color: rgba(0, 0, 0, 0);
    margin-top: 1px;
}

.pilot-left-meta .pilot-kicker { -unity-text-align: middle-left; }
.pilot-left-meta .pilot-stat-value { -unity-text-align: middle-left; }
.pilot-right-meta .pilot-meta-line { -unity-text-align: middle-right; }

.pilot-zone {
    /* Centered on player arrow / map ring (stage center 104). */
    position: absolute;
    left: 104px;
    top: 28px;
    width: 200px;
    margin-left: -100px;
    color: #C02E7A;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 0.6px;
    -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0);
}

.pilot-compass {
    position: absolute;
    left: 50%;
    top: 10px;
    width: 486px;
    margin-left: -243px;
    height: 84px;
    background-color: rgba(0, 0, 0, 0);
    overflow: visible;
}

.pilot-compass-ticks {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 36px;
    background-color: rgba(0, 0, 0, 0);
    overflow: hidden;
}

.pilot-compass-tick {
    position: absolute;
    bottom: 0;
    width: 36px;
    height: 36px;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    background-color: rgba(0, 0, 0, 0);
}

.pilot-compass-tick-label {
    font-size: 10px;
    color: #8C7F75;
    -unity-text-align: upper-center;
    background-color: rgba(0, 0, 0, 0);
    margin-bottom: 1px;
}

.pilot-compass-tick-cardinal {
    font-size: 13px;
    color: #D4A017;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    background-color: rgba(0, 0, 0, 0);
    margin-bottom: 1px;
}

.pilot-compass-tick-line {
    width: 1px;
    height: 7px;
    background-color: rgba(237, 233, 228, 0.55);
}

.pilot-compass-tick-line-cardinal {
    width: 2px;
    height: 10px;
    background-color: #D4A017;
}

.pilot-compass-line {
    position: absolute;
    left: 0;
    right: 0;
    top: 36px;
    height: 2px;
    background-color: #D4A017;
}

.pilot-compass-dots {
    position: absolute;
    left: 0;
    right: 0;
    top: 28px;
    height: 18px;
    background-color: rgba(0, 0, 0, 0);
    overflow: visible;
}

.pilot-compass-dot {
    position: absolute;
    top: 50%;
    width: 8px;
    height: 8px;
    margin-top: -4px;
    margin-left: -4px;
    background-color: #C02E7A;
    border-radius: 4px;
}

.pilot-compass-center {
    position: absolute;
    left: 50%;
    top: 32px;
    width: 8px;
    height: 8px;
    margin-left: -4px;
    background-color: #EDE9E4;
    border-radius: 1px;
    rotate: 45deg;
}

.pilot-compass-poi {
    position: absolute;
    left: 0;
    right: 0;
    top: 58px;
    height: 22px;
    color: #C02E7A;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 0.4px;
    -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0);
}


/* Jetfuel storage: under compass crossbar, centered, ~3/4 of bar width (486 * 0.75). */
.pilot-jetfuel {
    position: absolute;
    left: 50%;
    top: 40px;
    width: 364px;
    margin-left: -182px;
    height: 16px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
}

.pilot-jetfuel-label {
    color: #D4A017;
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-left;
    width: 34px;
    margin-right: 6px;
    background-color: rgba(0, 0, 0, 0);
}

.pilot-jetfuel-track {
    flex-grow: 1;
    height: 10px;
    background-color: rgba(28, 42, 56, 0.35);
    border-width: 1px;
    border-color: #8A6A12;
    overflow: hidden;
    justify-content: flex-start;
}

.pilot-jetfuel-fill {
    /* Replaced at runtime by FuelDashes painter. Keep host for Builder. */
    width: 100%;
    height: 100%;
    background-color: rgb(78, 200, 232);
}
