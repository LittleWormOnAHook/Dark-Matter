/* DMUiToolkit 0901-finish — hex graph, companions portraits, pet toolbar, storage, fog */
.dmg-hex-scroll {
    flex-grow: 1;
    min-height: 280px;
    background-color: rgba(28, 42, 56, 0.88);
    border-width: 1px;
    border-color: rgb(74, 74, 90);
}

.dmg-hex-host {
    position: relative;
    min-width: 420px;
    min-height: 280px;
    background-color: rgba(15, 20, 28, 0.55);
}

.dmg-hex-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
}

.dmg-hex-node {
    position: absolute;
    width: 92px;
    height: 92px;
    overflow: hidden;
}

.dmg-hex-label {
    position: absolute;
    left: 10px;
    right: 10px;
    top: 28px;
    height: 36px;
    color: rgb(237, 233, 228);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.dmg-hex-dots {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 10px;
    height: 10px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.dmg-hex-dot {
    width: 8px;
    height: 8px;
    margin-right: 3px;
    -unity-background-scale-mode: scale-to-fit;
}

.dmg-hex-path {
    position: absolute;
    height: 4px;
    background-color: rgba(140, 127, 117, 0.55);
}

.dmg-companion-row {
    flex-direction: column;
    align-items: center;
    width: 96px;
    min-width: 96px;
    margin: 8px;
    padding: 6px 4px;
