    margin-top: 8px;
}

.dmg-map-fog {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: stretch-to-fill;
}

.dmg-companions-roster-row {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    align-items: stretch;
    min-height: 220px;
}

.dmg-companion-grid {
    flex-grow: 1;
    flex-shrink: 1;
    height: auto;
    min-width: 240px;
    background-color: rgba(28, 42, 56, 0.88);
    border-width: 1px;
    border-color: rgb(74, 74, 90);
    margin-right: 12px;
}

.dmg-camp-column {
    width: 280px;
    min-width: 240px;
    flex-grow: 1;
    flex-shrink: 0;
    flex-direction: column;
    padding: 8px 10px;
    background-color: rgba(28, 42, 56, 0.88);
    border-width: 1px;
    border-color: rgb(74, 74, 90);
}

.dmg-camp-list {
    flex-grow: 1;
    min-height: 80px;
    background-color: rgba(28, 42, 56, 0.88);
    border-width: 1px;
    border-color: rgb(74, 74, 90);
}

.dmg-companion-row-name {
    color: rgb(182, 168, 222);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    white-space: normal;
    overflow: hidden;
}

.dmg-companion-row-initials {
    width: 100%;
    height: 100%;
    color: rgb(237, 233, 228);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.dmg-ach-scroll {
    flex-grow: 1;
}

.dmg-inv-hotbar-block {
    margin-top: 12px;
    padding: 12px;
    background-color: rgba(28, 42, 56, 0.92);
    border-width: 1px;
    border-color: rgb(212, 160, 23);
    flex-direction: column;
    align-self: center;
    width: 884px;
}

.dmg-inv-hotbar-title {
    color: rgb(212, 160, 23);
    font-size: 16px;
    letter-spacing: 4px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.dmg-inv-hotbar-row {
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: center;
}

.dmg-inv-tools-row {
    margin-top: 8px;
}

.dmg-inv-hotbar-slot {
    width: 82px;
    height: 82px;
    margin: 2px;
    background-color: rgba(28, 42, 56, 0.92);
    border-width: 2px;
    border-color: rgb(74, 74, 90);
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.dmg-inv-hotbar-slot--selected {
    border-color: rgb(212, 160, 23);
    background-color: rgba(74, 74, 90, 0.55);
}

.dmg-inv-hotbar-icon {
    position: absolute;
    left: 1px;
    top: 1px;
    right: 1px;
    bottom: 1px;
    width: auto;
    height: auto;
    -unity-background-scale-mode: scale-to-fit;
}

.dmg-inv-hotbar-key {
    position: absolute;
    right: 4px;
    bottom: 4px;
    left: auto;
    top: auto;
    font-size: 13px;
    color: rgba(212, 160, 23, 0.75);
    -unity-font-style: bold;
    -unity-text-align: lower-right;
}

.dmg-inv-hotbar-amount {
    position: absolute;
    right: 4px;
    bottom: 18px;
    font-size: 12px;
    color: rgb(237, 233, 228);
    -unity-font-style: bold;
}

.dmg-inv-ctx-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    display: none;
    background-color: rgba(0, 0, 0, 0);
}


/* Skills tab only: ~67/33 split, tree centered in left pane */
#skills-left {
    width: 67%;
    flex-grow: 0;
    flex-shrink: 1;
    align-items: center;
}

#skills-right {
    width: 33%;
    flex-grow: 0;
    flex-shrink: 0;
    min-width: 240px;
    align-items: stretch;
}

#skills-hex-scroll {
    width: 100%;
    flex-grow: 1;
}

#skills-hex-host {
    align-self: center;
}

/* Prototype skill illustration card under Allocate Point */
.dmg-skills-card {
    width: 220px;
    height: 308px;
    max-width: 92%;
    margin-top: 48px;
    flex-shrink: 0;
    align-self: center;
    position: relative;
    background-color: rgba(28, 42, 56, 0.94);
    border-width: 1px;
    border-color: rgb(212, 160, 23);
    border-radius: 6px;
    overflow: hidden;
    flex-direction: column;
}

.dmg-skills-card-art {
    width: 100%;
    height: 268px;
    flex-shrink: 0;
    background-color: rgba(47, 47, 47, 0.85);
    -unity-background-scale-mode: scale-and-crop;
}

.dmg-skills-card-caption {
    height: 44px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    font-size: 12px;
    color: rgb(237, 233, 228);
    white-space: normal;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}
