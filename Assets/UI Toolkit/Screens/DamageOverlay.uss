/* DMUiToolkit 0901-finish */
.dmg-damage-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    -unity-font-definition: url("project://database/Assets/Shift%20-%20Complete%20Sci-Fi%20UI/Fonts/Rajdhani-SemiBold.ttf?fileID=12800000&guid=28b6d07166d6d8947a6671e5480cbf66&type=3#Rajdhani-SemiBold");
}

.dmg-damage-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
}

.dmg-dmg-num {
    position: absolute;
    width: 120px;
    height: 40px;
    font-size: 28px;
    color: rgb(242, 46, 31);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.dmg-dmg-crit {
    color: rgb(255, 209, 31);
}


/* AAA world proximity dots (pickups / interactables) */
.dmg-world-dots {
    overflow: visible;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
}

.dmg-world-dot {
    position: absolute;
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background-color: rgba(212, 160, 23, 0.28);
    align-items: center;
    justify-content: center;
}

.dmg-world-dot-core {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: rgba(212, 160, 23, 0.92);
    border-width: 1px;
    border-color: rgba(20, 28, 36, 0.55);
}

.dmg-world-bars {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
}



/* 0x0 marker so absolute stem/dot left/top are host-local panel coords (not a stretched box). */
.dmg-world-dot-host {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    overflow: visible;
}

.dmg-world-dot-stem {
    position: absolute;
    width: 2px;
    height: 2px;
    background-color: rgba(212, 160, 23, 0.85);
    /* Left-center: stem base stays welded to world anchor under rotate. */
    transform-origin: 0% 50%;
}

.dmg-world-dot {
    position: absolute;
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background-color: rgba(212, 160, 23, 0.28);
    align-items: center;
    justify-content: center;
}

.dmg-world-dot-core {
    width: 50%;
    height: 50%;
    border-radius: 50%;
    background-color: rgba(212, 160, 23, 0.92);
    border-width: 1px;
    border-color: rgba(20, 28, 36, 0.55);
}

/* Close-range Hold-E pickup prompt (tip-locked) */
.dmg-world-close {
    position: absolute;
    overflow: visible;
}

.dmg-world-close-row {
    flex-direction: row;
    align-items: center;
    overflow: visible;
}

.dmg-world-close-info {
    background-color: rgba(18, 24, 32, 0.82);
    border-width: 1px;
    border-color: rgba(212, 160, 23, 0.65);
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.dmg-world-close-icon {
    -unity-background-scale-mode: scale-to-fit;
}

.dmg-world-close-unknown {
    font-size: 18px;
    color: rgb(245, 230, 180);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

.dmg-world-close-name {
    font-size: 16px;
    color: rgb(245, 230, 180);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.75);
    white-space: nowrap;
}

.dmg-world-close-keyhost {
    overflow: visible;
}

.dmg-world-close-ring {
    background-color: rgba(0, 0, 0, 0);
}

.dmg-world-close-key {
    background-color: rgba(18, 24, 32, 0.88);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.35);
    align-items: center;
    justify-content: center;
}

.dmg-world-close-keylabel {
    font-size: 16px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
}

.dmg-world-close-action {
    font-size: 16px;
    color: rgb(245, 230, 180);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.75);
    white-space: nowrap;
}
