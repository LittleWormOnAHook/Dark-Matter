.dmg-hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    -unity-font-definition: url("project://database/Assets/Shift%20-%20Complete%20Sci-Fi%20UI/Fonts/Rajdhani-Regular.ttf?fileID=12800000&guid=11524516bb0f95d4ba72a86cdd3756e0&type=3#Rajdhani-Regular");
}
.dmg-hud-hotbar {
    position: absolute;
    left: 50%;
    bottom: 24px;
    width: 572px;
    height: 64px;
    margin-left: -286px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 6px 8px;
    background-color: rgba(28, 42, 56, 0.55);
}
.dmg-hud-tools {
    position: absolute;
    left: 50%;
    bottom: 24px;
    width: 120px;
    height: 64px;
    margin-left: -430px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 6px 8px;
    background-color: rgba(28, 42, 56, 0.55);
}
.dmg-hud-slot {
    width: 52px;
    height: 52px;
    margin-right: 4px;
    background-color: rgba(28, 42, 56, 0.96);
    border-width: 1px;
    border-color: rgba(237, 233, 228, 0.22);
    -unity-background-scale-mode: scale-to-fit;
    overflow: hidden;
}

#hotbar-slot-9,
#tool-slot-1 {
    margin-right: 0;
}
.dmg-hud-slot-icon {
    position: absolute;
    left: 1px;
    top: 1px;
    right: 1px;
    bottom: 1px;
    width: auto;
    height: auto;
    -unity-background-scale-mode: scale-to-fit;
}
.dmg-hud-slot-key {
    position: absolute;
    right: 2px;
    bottom: 2px;
    left: auto;
    top: auto;
    font-size: 10px;
    color: rgba(212, 160, 23, 0.75);
    -unity-font-style: bold;
    -unity-text-align: lower-right;
    translate: 0 0;
}
.dmg-hud-prompt {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 760px;
    height: 56px;
    margin-left: -380px;
    margin-top: -124px;
    font-size: 28px;
    color: rgb(242, 208, 86);
    -unity-text-align: middle-center;
    background-color: rgba(43, 43, 43, 0);
}
.dmg-hud-no-power {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 280px;
    height: 36px;
    margin-left: -140px;
    margin-top: 36px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(28, 42, 56, 0);
}
.dmg-hud-no-power-icon {
    width: 28px;
    height: 28px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/_Project/Art/Icons/Ammo/Ammo_Electricity.png");
}
.dmg-hud-no-power-label {
    font-size: 22px;
    color: rgb(212, 160, 23);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}
.dmg-hud-radio {
    position: absolute;
    left: 24px;
    bottom: 24px;
    width: 280px;
    min-height: 48px;
    padding: 8px 12px;
    background-color: rgba(28, 42, 56, 0.88);
    border-left-width: 3px;
    border-left-color: rgb(192, 46, 122);
}
.dmg-hud-radio-title {
    font-size: 11px;
    color: rgb(212, 160, 23);
    -unity-font-style: bold;
    margin-bottom: 2px;
}
.dmg-hud-radio-body {
    font-size: 14px;
    color: rgb(237, 233, 228);
    white-space: normal;
}
.dmg-hud-popups {
    position: absolute;
    left: 20px;
    top: 50%;
    width: 360px;
    margin-left: 0;
    translate: 0 -50%;
    flex-direction: column;
    align-items: flex-start;
    white-space: normal;
    -unity-text-align: middle-left;
    background-color: rgba(0, 0, 0, 0);
}
.dmg-hud-popup {
    width: 300px;
    min-height: 28px;
    margin-bottom: 4px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    -unity-background-scale-mode: stretch-to-fill;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    -unity-slice-left: 0;
    -unity-slice-top: 0;
    -unity-slice-right: 0;
    -unity-slice-bottom: 0;
    border-width: 0;
    border-color: rgba(0, 0, 0, 0);
}
.dmg-hud-popup-text {
    flex-grow: 1;
    font-size: 30px;
    color: rgb(237, 233, 228);
    -unity-text-align: middle-left;
    -unity-font-style: bold;
}
.dmg-hud-slot-amount {
    position: absolute;
    right: 4px;
    bottom: 16px;
    font-size: 10px;
    color: rgb(237, 233, 228);
    -unity-font-style: bold;
}
.dmg-hud-slot-selected {
    border-width: 2px;
    border-color: rgb(180, 140, 255);
}
.dmg-hud-ammo {
    position: absolute;
    left: 50%;
    bottom: 118px;
    width: 576px;
    height: 22px;
    margin-left: -288px;
    font-size: 16px;
    color: rgb(237, 233, 228);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}
.dmg-hud-enemy-focus {
    position: absolute;
    left: 50%;
    top: 90px;
    width: 640px;
    height: 34px;
    margin-left: -320px;
    flex-direction: column;
    align-items: stretch;
    translate: 0 0;
}
.dmg-hud-enemy-name {
    height: 22px;
    font-size: 16px;
    color: rgb(237, 233, 228);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}
.dmg-hud-enemy-track {
    position: relative;
    width: 100%;
    height: 8px;
    background-color: rgba(47, 47, 47, 0.9);
    overflow: hidden;
    -unity-background-scale-mode: stretch-to-fill;
}
.dmg-hud-enemy-fill {
    position: absolute;
    left: 0;
    top: 0;
    width: 70%;
    height: 100%;
    background-color: rgb(235, 46, 36);
}
/* DMUiToolkit 0901-minimap ? circular minimap + compass. Do not use display:none here. */
/* DMUiToolkit 0901-finish — minimap +/- Scan, fog overlay, popup 9-slice authoring */
.dmg-hud-popup {
    -unity-slice-left: 0;
    -unity-slice-top: 0;
    -unity-slice-right: 0;
    -unity-slice-bottom: 0;
    border-width: 0;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
}
.dmg-hud-popup-preview {
    min-height: 28px;
    margin-bottom: 6px;
}
/* DMUiToolkit HUD expedition trio — C# hides empty slots; do not display:none here. */
.dmg-hud-companions {
    position: absolute;
    left: 50%;
    bottom: 24px;
    margin-left: 298px;
    flex-direction: row;
    align-items: flex-end;
}
.dmg-hud-companion {
    width: 76px;
    height: 76px;
    margin-right: 8px;
    background-color: rgba(47, 47, 47, 0.92);
    border-width: 3px;
    border-color: rgb(212, 160, 23);
    border-top-left-radius: 38px;
    border-top-right-radius: 38px;
    border-bottom-left-radius: 38px;
    border-bottom-right-radius: 38px;
    overflow: hidden;
}
.dmg-hud-companion-health {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    width: 100%;
    height: 18%;
    background-color: rgb(90, 196, 122);
}
.dmg-hud-companion-icon {
    position: absolute;
    left: 4px;
    top: 4px;
    right: 4px;
    bottom: 16px;
    width: auto;
    height: auto;
    -unity-background-scale-mode: scale-to-fit;
}
.dmg-hud-companion-name {
    position: absolute;
    left: 2px;
    right: 2px;
    bottom: 2px;
    color: rgb(237, 233, 228);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    overflow: hidden;
}

.dmg-weapon-reticle {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    transform-origin: center;
}

.dmg-weapon-reticle-spread {
    position: absolute;
    width: 64px;
    height: 64px;
    margin-left: -32px;
    margin-top: -32px;
    transform-origin: center;
}

.dmg-weapon-reticle-dot {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    margin-top: -2px;
    border-radius: 2px;
    background-color: rgba(237, 233, 228, 0.92);
}

.dmg-weapon-reticle-arm {
    position: absolute;
    background-color: rgba(237, 233, 228, 0.82);
    transform-origin: center;
}

.dmg-weapon-reticle-arm-h {
    width: 10px;
    height: 2px;
    top: 50%;
    left: 50%;
    margin-left: -5px;
    margin-top: -1px;
}

.dmg-weapon-reticle-arm-v {
    width: 2px;
    height: 10px;
    left: 50%;
    top: 50%;
    margin-left: -1px;
    margin-top: -5px;
}

.dmg-weapon-reticle-hit {
    opacity: 0.45;
}

.dmg-weapon-reticle-hit .dmg-weapon-reticle-dot {
    background-color: rgb(212, 160, 23);
}

.dmg-weapon-reticle-hit .dmg-weapon-reticle-arm {
    background-color: rgba(212, 160, 23, 0.88);
}

.dmg-zone-toast {
    position: absolute;
    left: 0;
    top: 0;
    width: 220px;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.dmg-zone-toast-accent {
    display: none;
    width: 0;
    height: 0;
    background-color: rgba(0, 0, 0, 0);
}

.dmg-zone-toast-heading {
    margin-top: 2px;
    font-size: 11px;
    color: rgb(212, 160, 23);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 0.8px;
}

.dmg-zone-toast-name {
    margin-top: 0;
    font-size: 13px;
    color: rgb(212, 160, 23);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.dmg-build-hold-ring {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 64px;
    height: 64px;
    margin-left: -32px;
    margin-top: -32px;
}

.dmg-build-bar {
    position: absolute;
    left: 50%;
    bottom: 96px;
    width: 900px;
    margin-left: -450px;
    flex-direction: column;
    align-items: center;
}

.dmg-build-list {
    position: absolute;
    left: 0;
    bottom: 176px;
    width: 220px;
    max-height: 240px;
    padding: 6px;
    background-color: rgb(28, 42, 56);
    border-width: 1px;
    border-color: rgb(74, 74, 90);
}

.dmg-build-list-header {
    margin-top: 4px;
    margin-bottom: 2px;
    padding-left: 4px;
    font-size: 11px;
    color: rgb(140, 127, 117);
    -unity-font-style: bold;
}

.dmg-build-list-row {
    height: 28px;
    margin-bottom: 4px;
    color: rgb(237, 233, 228);
    background-color: rgb(47, 47, 47);
    border-width: 0;
    -unity-text-align: middle-left;
}

.dmg-build-list-row-selected {
    background-color: rgb(192, 46, 122);
    color: rgb(237, 233, 228);
}

.dmg-build-name {
    margin-bottom: 6px;
    padding: 0;
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(212, 160, 23);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-text-align: middle-center;
    text-shadow: 2px 2px 3px rgba(0, 0, 0, 0.85);
    white-space: nowrap;
    align-self: center;
}

.dmg-build-cost {
    margin-top: 6px;
    margin-bottom: 0;
    padding: 0;
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(237, 233, 228);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-text-align: middle-center;
    text-shadow: 2px 2px 3px rgba(0, 0, 0, 0.85);
    white-space: nowrap;
    align-self: center;
}

.dmg-build-row {
    flex-direction: row;
    align-items: center;
    align-self: center;
    padding: 4px;
    background-color: rgba(28, 42, 56, 0.92);
    border-width: 1px;
    border-color: rgb(74, 74, 90);
}

.dmg-build-arrow {
    width: 28px;
    height: 72px;
    margin: 2px;
    color: rgb(237, 233, 228);
    background-color: rgb(143, 30, 94);
    border-width: 0;
    font-size: 16px;
}

.dmg-build-slots {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.dmg-build-slot {
    width: 72px;
    height: 72px;
    min-width: 72px;
    flex-shrink: 0;
    flex-direction: column;
    margin: 2px;
    overflow: hidden;
    background-color: rgb(28, 42, 56);
    border-width: 1px;
    border-color: rgb(74, 74, 90);
    align-items: center;
    justify-content: center;
}

.dmg-build-slot-selected {
    border-color: rgb(192, 46, 122);
    border-width: 2px;
}

.dmg-build-slot-short {
    background-color: rgb(74, 74, 90);
}

.dmg-build-slot-icon {
    position: absolute;
    left: 5px;
    top: 5px;
    right: 5px;
    bottom: 5px;
    -unity-background-scale-mode: scale-to-fit;
}

.dmg-build-slot-label {
    padding: 2px;
    font-size: 11px;
    color: rgb(237, 233, 228);
    -unity-text-align: middle-center;
    white-space: normal;
}
