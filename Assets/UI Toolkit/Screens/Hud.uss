.dmg-hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    -unity-font-definition: url("project://database/Assets/Shift%20-%20Complete%20Sci-Fi%20UI/Fonts/Rajdhani-Regular.ttf?fileID=12800000&guid=11524516bb0f95d4ba72a86cdd3756e0&type=3#Rajdhani-Regular");
}
.dmg-hud-hotbar {
    position: absolute;
    left: 50%;
    bottom: 24px;
    width: 572px;
    height: 64px;
    margin-left: -286px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 6px 8px;
    background-color: rgba(28, 42, 56, 0.55);
}
.dmg-hud-tools {
    position: absolute;
    left: 50%;
    bottom: 24px;
    width: 120px;
    height: 64px;
    margin-left: -430px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 6px 8px;
    background-color: rgba(28, 42, 56, 0.55);
}
.dmg-hud-slot {
    width: 52px;
    height: 52px;
    margin-right: 4px;
    background-color: rgba(28, 42, 56, 0.96);
    border-width: 1px;
    border-color: rgba(237, 233, 228, 0.22);
    -unity-background-scale-mode: scale-to-fit;
    overflow: hidden;
}

#hotbar-slot-9,
#tool-slot-1 {
    margin-right: 0;
}
.dmg-hud-slot-icon {
    position: absolute;
    left: 1px;
    top: 1px;
    right: 1px;
    bottom: 1px;
    width: auto;
    height: auto;
    -unity-background-scale-mode: scale-to-fit;
}
.dmg-hud-slot-key {
    position: absolute;
    right: 2px;
    bottom: 2px;
    left: auto;
    top: auto;
    font-size: 10px;
    color: rgba(212, 160, 23, 0.75);
    -unity-font-style: bold;
    -unity-text-align: lower-right;
    translate: 0 0;
}
.dmg-hud-prompt {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 760px;
    height: 56px;
    margin-left: -380px;
    margin-top: -124px;
    font-size: 28px;
    color: rgb(242, 208, 86);
    -unity-text-align: middle-center;
    background-color: rgba(43, 43, 43, 0);
}
.dmg-hud-radio {
    position: absolute;
    left: 24px;
    bottom: 24px;
    width: 280px;
    min-height: 48px;
    padding: 8px 12px;
    background-color: rgba(28, 42, 56, 0.88);
    border-left-width: 3px;
    border-left-color: rgb(192, 46, 122);
}
.dmg-hud-radio-title {
    font-size: 11px;
    color: rgb(212, 160, 23);
    -unity-font-style: bold;
    margin-bottom: 2px;
}
.dmg-hud-radio-body {
    font-size: 14px;
    color: rgb(237, 233, 228);
    white-space: normal;
}
.dmg-hud-popups {
    position: absolute;
    left: 20px;
    top: 50%;
    width: 360px;
    margin-left: 0;
    translate: 0 -50%;
    flex-direction: column;
    align-items: flex-start;
    white-space: normal;
    -unity-text-align: middle-left;
    background-color: rgba(0, 0, 0, 0);
}
.dmg-hud-popup {
    width: 300px;
    min-height: 28px;
    margin-bottom: 4px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    -unity-background-scale-mode: stretch-to-fill;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    -unity-slice-left: 0;
    -unity-slice-top: 0;
    -unity-slice-right: 0;
    -unity-slice-bottom: 0;
    border-width: 0;
    border-color: rgba(0, 0, 0, 0);
}
.dmg-hud-popup-text {
    flex-grow: 1;
    font-size: 30px;
    color: rgb(237, 233, 228);
    -unity-text-align: middle-left;
    -unity-font-style: bold;
}
.dmg-hud-slot-amount {
    position: absolute;
    right: 4px;
    bottom: 16px;
    font-size: 10px;
    color: rgb(237, 233, 228);
    -unity-font-style: bold;
}
.dmg-hud-slot-selected {
    border-width: 2px;
    border-color: rgb(180, 140, 255);
}
.dmg-hud-ammo {
    position: absolute;
    left: 50%;
    bottom: 118px;
    width: 576px;
    height: 22px;
    margin-left: -288px;
    font-size: 16px;
    color: rgb(237, 233, 228);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}
.dmg-hud-enemy-focus {
    position: absolute;
    left: 50%;
    top: 90px;
    width: 640px;
    height: 34px;
    margin-left: -320px;
    flex-direction: column;
    align-items: stretch;
    translate: 0 0;
}
.dmg-hud-enemy-name {
    height: 22px;
    font-size: 16px;
    color: rgb(237, 233, 228);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}
.dmg-hud-enemy-track {
    position: relative;
    width: 100%;
    height: 8px;
    background-color: rgba(47, 47, 47, 0.9);
    overflow: hidden;
    -unity-background-scale-mode: stretch-to-fill;
}
.dmg-hud-enemy-fill {
    position: absolute;
    left: 0;
    top: 0;
    width: 70%;
    height: 100%;
    background-color: rgb(235, 46, 36);
}
/* DMUiToolkit 0901-minimap ? circular minimap + compass. Do not use display:none here. */
/* DMUiToolkit 0901-finish — minimap +/- Scan, fog overlay, popup 9-slice authoring */
.dmg-hud-popup {
    -unity-slice-left: 0;
    -unity-slice-top: 0;
    -unity-slice-right: 0;
    -unity-slice-bottom: 0;
    border-width: 0;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
}
.dmg-hud-popup-preview {
    min-height: 28px;
    margin-bottom: 6px;
}
/* DMUiToolkit HUD expedition trio — C# hides empty slots; do not display:none here. */
.dmg-hud-companions {
    position: absolute;
    left: 50%;
    bottom: 24px;
    margin-left: 298px;
    flex-direction: row;
    align-items: flex-end;
}
.dmg-hud-companion {
    width: 76px;
    height: 76px;
    margin-right: 8px;
    background-color: rgba(47, 47, 47, 0.92);
    border-width: 3px;
    border-color: rgb(212, 160, 23);
    border-top-left-radius: 38px;
    border-top-right-radius: 38px;
    border-bottom-left-radius: 38px;
    border-bottom-right-radius: 38px;
    overflow: hidden;
}
.dmg-hud-companion-health {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    width: 100%;
    height: 18%;
    background-color: rgb(90, 196, 122);
}
.dmg-hud-companion-icon {
    position: absolute;
    left: 4px;
    top: 4px;
    right: 4px;
    bottom: 16px;
    width: auto;
    height: auto;
    -unity-background-scale-mode: scale-to-fit;
}
.dmg-hud-companion-name {
    position: absolute;
    left: 2px;
    right: 2px;
    bottom: 2px;
    color: rgb(237, 233, 228);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    overflow: hidden;
}
