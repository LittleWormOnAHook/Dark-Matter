.dmg-hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    -unity-font-definition: url("project://database/Assets/Shift%20-%20Complete%20Sci-Fi%20UI/Fonts/Rajdhani-Regular.ttf?fileID=12800000&guid=11524516bb0f95d4ba72a86cdd3756e0&type=3#Rajdhani-Regular");
}

.dmg-hud-bars {
    position: absolute;
    left: 50%;
    bottom: 100px;
    width: 576px;
    height: 12px;
    margin-left: -288px;
    flex-direction: row;
    align-items: stretch;
}

.dmg-hud-bar {
    flex-grow: 1;
    flex-shrink: 1;
    height: 12px;
    margin-right: 8px;
    position: relative;
}

#bar-oxygen {
    margin-right: 0;
}

.dmg-hud-bar-track {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(30, 86, 141, 0.82);
    overflow: hidden;
    opacity: 1;
    scale: 1 1.5;
    margin-top: 7px;
}

.dmg-hud-bar-fill {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

.dmg-hud-fill-health {
    background-color: rgb(235, 46, 36);
}

.dmg-hud-fill-energy {
    background-color: rgb(232, 161, 69);
}

.dmg-hud-fill-stamina {
    background-color: rgb(181, 224, 102);
}

.dmg-hud-fill-oxygen {
    background-color: rgb(192, 46, 122);
}

.dmg-hud-bar-label {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    font-size: 12px;
    color: rgb(0, 0, 0);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    margin-top: 8px;
    -unity-font-definition: url("project://database/Assets/Shift%20-%20Complete%20Sci-Fi%20UI/Fonts/Rajdhani-Regular.ttf?fileID=12800000&guid=11524516bb0f95d4ba72a86cdd3756e0&type=3#Rajdhani-Regular");
    translate: -53px 0;
}

.dmg-hud-hotbar {
    position: absolute;
    left: 50%;
    bottom: 24px;
    width: 572px;
    height: 64px;
    margin-left: -286px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 6px 8px;
    background-color: rgba(28, 42, 56, 0.55);
}

.dmg-hud-tools {
    position: absolute;
    left: 50%;
    bottom: 24px;
    width: 120px;
    height: 64px;
    margin-left: -430px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 6px 8px;
    background-color: rgba(28, 42, 56, 0.55);
}

.dmg-hud-slot {
    width: 52px;
    height: 52px;
    margin-right: 4px;
    background-color: rgba(28, 42, 56, 0.96);
    border-width: 1px;
    border-color: rgba(237, 233, 228, 0.22);
    -unity-background-scale-mode: scale-to-fit;
    overflow: hidden;
}

#hotbar-slot-9,
#tool-slot-1 {
    margin-right: 0;
}

.dmg-hud-slot-icon {
    position: absolute;
    left: 1px;
    top: 1px;
    right: 1px;
    bottom: 1px;
    width: auto;
    height: auto;
    -unity-background-scale-mode: scale-to-fit;
}

.dmg-hud-slot-key {
    position: absolute;
    right: 4px;
    bottom: 4px;
    left: auto;
    top: auto;
    font-size: 10px;
    color: rgba(212, 160, 23, 0.75);
    -unity-font-style: bold;
    -unity-text-align: lower-right;
    translate: 0 0;
}

.dmg-hud-prompt {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 760px;
    height: 56px;
    margin-left: -380px;
    margin-top: -124px;
    font-size: 28px;
    color: rgb(242, 208, 86);
    -unity-text-align: middle-center;
    background-color: rgba(43, 43, 43, 0);
}

.dmg-hud-radio {
    position: absolute;
    left: 24px;
    bottom: 24px;
    width: 280px;
    min-height: 48px;
    padding: 8px 12px;
    background-color: rgba(28, 42, 56, 0.88);
    border-left-width: 3px;
    border-left-color: rgb(192, 46, 122);
}

.dmg-hud-radio-title {
    font-size: 11px;
    color: rgb(212, 160, 23);
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.dmg-hud-radio-body {
    font-size: 14px;
    color: rgb(237, 233, 228);
    white-space: normal;
}

.dmg-hud-popups {
    position: absolute;
    left: 20px;
    top: 50%;
    width: 360px;
    margin-left: 0;
    translate: 0 -50%;
    flex-direction: column;
    align-items: flex-start;
    white-space: normal;
    -unity-text-align: middle-left;
    background-color: rgba(0, 0, 0, 0);
}

.dmg-hud-popup {
    width: 300px;
    min-height: 28px;
    margin-bottom: 4px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    -unity-background-scale-mode: stretch-to-fill;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    -unity-slice-left: 0;
    -unity-slice-top: 0;
    -unity-slice-right: 0;
    -unity-slice-bottom: 0;
    border-width: 0;
    border-color: rgba(0, 0, 0, 0);
}

.dmg-hud-popup-text {
    flex-grow: 1;
    font-size: 30px;
    color: rgb(237, 233, 228);
    -unity-text-align: middle-left;
    -unity-font-style: bold;
}

.dmg-hud-slot-amount {
    position: absolute;
    right: 4px;
    bottom: 16px;
    font-size: 10px;
    color: rgb(237, 233, 228);
    -unity-font-style: bold;
}

.dmg-hud-slot-selected {
    border-width: 2px;
    border-color: rgb(180, 140, 255);
}

.dmg-hud-xp {
    position: absolute;
    left: 50%;
    bottom: 4px;
    width: 572px;
    height: 18px;
    margin-left: -286px;
    flex-direction: row;
    align-items: stretch;
}

.dmg-hud-xp-track {
    position: relative;
    flex-grow: 1;
    height: 14px;
    margin-top: 2px;
    background-color: rgb(74, 74, 90);
    overflow: hidden;
    -unity-background-scale-mode: stretch-to-fill;
}

.dmg-hud-xp-fill {
    position: absolute;
    left: 0;
    top: 0;
    width: 62%;
    height: 100%;
    background-color: rgb(212, 160, 23);
}

.dmg-hud-xp-label {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    font-size: 12px;
    color: rgb(237, 233, 228);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.dmg-hud-ammo {
    position: absolute;
    left: 50%;
    bottom: 118px;
    width: 576px;
    height: 22px;
    margin-left: -288px;
    font-size: 16px;
    color: rgb(237, 233, 228);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.dmg-hud-enemy-focus {
    position: absolute;
    left: 50%;
    top: 28px;
    width: 640px;
    height: 34px;
    margin-left: -320px;
    flex-direction: column;
    align-items: stretch;
}

.dmg-hud-enemy-name {
    height: 22px;
    font-size: 16px;
    color: rgb(237, 233, 228);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.dmg-hud-enemy-track {
    position: relative;
    width: 100%;
    height: 8px;
    background-color: rgba(47, 47, 47, 0.9);
    overflow: hidden;
    -unity-background-scale-mode: stretch-to-fill;
}

.dmg-hud-enemy-fill {
    position: absolute;
    left: 0;
    top: 0;
    width: 70%;
    height: 100%;
    background-color: rgb(235, 46, 36);
}

/* DMUiToolkit 0901-minimap ? circular minimap + compass. Do not use display:none here. */
.dmg-hud-minimap {
    position: absolute;
    right: 16px;
    top: 16px;
    width: 240px;
    flex-direction: column;
    align-items: flex-end;
}

.dmg-hud-minimap-frame {
    width: 147px;
    height: 147px;
    border-top-left-radius: 74px;
    border-top-right-radius: 74px;
    border-bottom-left-radius: 74px;
    border-bottom-right-radius: 74px;
    border-width: 3px;
    border-color: rgb(192, 46, 122);
    background-color: rgba(28, 42, 56, 0.45);
    overflow: hidden;
}

.dmg-hud-minimap-view {
    position: absolute;
    left: 4px;
    top: 4px;
    right: 4px;
    bottom: 4px;
    width: auto;
    height: auto;
    border-top-left-radius: 70px;
    border-top-right-radius: 70px;
    border-bottom-left-radius: 70px;
    border-bottom-right-radius: 70px;
    overflow: hidden;
    background-color: rgb(20, 32, 44);
    -unity-background-scale-mode: scale-and-crop;
}

.dmg-hud-minimap-player {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 24px;
    height: 24px;
    margin-left: -12px;
    margin-top: -12px;
    background-color: rgb(242, 46, 46);
    -unity-background-scale-mode: scale-to-fit;
}

.dmg-hud-compass {
    width: 240px;
    margin-top: 10px;
    flex-direction: column;
    align-items: stretch;
}

.dmg-hud-compass-strip {
    width: 240px;
    height: 40px;
    overflow: hidden;
    border-width: 2px;
    border-color: rgb(212, 160, 23);
    background-color: rgba(28, 42, 56, 0.55);
}

.dmg-hud-compass-ticks,
.dmg-hud-compass-markers {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
}

.dmg-hud-compass-tick {
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
}

.dmg-hud-compass-tick-line,
.dmg-hud-compass-tick-line-cardinal {
    width: 2px;
    height: 6px;
    background-color: rgba(237, 233, 228, 0.6);
}

.dmg-hud-compass-tick-line-cardinal {
    height: 10px;
    background-color: rgb(212, 160, 23);
}

.dmg-hud-compass-tick-label {
    font-size: 12px;
    color: rgb(140, 127, 117);
    -unity-text-align: upper-center;
}

.dmg-hud-compass-tick-cardinal {
    font-size: 14px;
    color: rgb(212, 160, 23);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
}

.dmg-hud-compass-pointer {
    width: 10px;
    height: 10px;
    margin-left: 115px;
    margin-top: 0;
    background-color: rgb(237, 233, 228);
    -unity-background-scale-mode: scale-to-fit;
}

.dmg-hud-compass-heading {
    height: 18px;
    font-size: 14px;
    color: rgb(212, 160, 23);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
}

.dmg-hud-minimap-info {
    margin-top: 5px;
    height: 24px;
    padding-left: 6px;
    padding-right: 6px;
    background-color: rgba(15, 20, 28, 0.95);
    font-size: 10px;
    color: rgb(237, 233, 228);
    -unity-text-align: middle-center;
}

.dmg-hud-compass-marker {
    width: 14px;
    height: 26px;
    flex-direction: column;
    align-items: center;
}

.dmg-hud-compass-marker-icon {
    width: 14px;
    height: 14px;
    background-color: rgb(212, 160, 23);
}

.dmg-hud-compass-marker-distance {
    height: 12px;
    font-size: 9px;
    color: rgb(140, 127, 117);
    -unity-text-align: upper-center;
}

/* DMUiToolkit 0901-finish — minimap +/- Scan, fog overlay, popup 9-slice authoring */
.dmg-hud-minimap-chrome {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

.dmg-hud-minimap-btn {
    width: 24px;
    height: 24px;
    margin-left: 4px;
    margin-right: 4px;
    background-color: rgba(18, 24, 34, 0.94);
    border-width: 1px;
    border-color: rgb(192, 46, 122);
    color: rgb(237, 233, 228);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.dmg-hud-minimap-scan {
    width: 72px;
    height: 22px;
    margin-top: 6px;
    margin-right: 38px;
    background-color: rgba(18, 24, 34, 0.94);
    border-width: 1px;
    border-color: rgb(212, 160, 23);
    color: rgb(212, 160, 23);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.dmg-hud-minimap-fog {
    position: absolute;
    left: 4px;
    top: 4px;
    right: 4px;
    bottom: 4px;
    width: auto;
    height: auto;
    border-top-left-radius: 70px;
    border-top-right-radius: 70px;
    border-bottom-left-radius: 70px;
    border-bottom-right-radius: 70px;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-and-crop;
}

.dmg-hud-popup {
    -unity-slice-left: 0;
    -unity-slice-top: 0;
    -unity-slice-right: 0;
    -unity-slice-bottom: 0;
    border-width: 0;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
}

.dmg-hud-popup-preview {
    min-height: 28px;
    margin-bottom: 6px;
}

/* DMUiToolkit HUD expedition trio — C# hides empty slots; do not display:none here. */
.dmg-hud-companions {
    position: absolute;
    left: 50%;
    bottom: 24px;
    margin-left: 298px;
    flex-direction: row;
    align-items: flex-end;
}
.dmg-hud-companion {
    width: 76px;
    height: 76px;
    margin-right: 8px;
    background-color: rgba(47, 47, 47, 0.92);
    border-width: 3px;
    border-color: rgb(212, 160, 23);
    border-top-left-radius: 38px;
    border-top-right-radius: 38px;
    border-bottom-left-radius: 38px;
    border-bottom-right-radius: 38px;
    overflow: hidden;
}
.dmg-hud-companion-health {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    width: 100%;
    height: 18%;
    background-color: rgb(90, 196, 122);
}
.dmg-hud-companion-icon {
    position: absolute;
    left: 4px;
    top: 4px;
    right: 4px;
    bottom: 16px;
    width: auto;
    height: auto;
    -unity-background-scale-mode: scale-to-fit;
}
.dmg-hud-companion-name {
    position: absolute;
    left: 2px;
    right: 2px;
    bottom: 2px;
    color: rgb(237, 233, 228);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    overflow: hidden;
}
