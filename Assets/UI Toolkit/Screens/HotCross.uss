/* Hot Cross — thin yellow-gold 4-quadrant cross + hollow ring; keep 40px center clip disk.
   stamp: hotcross-gold-quad 1006
   Anchored to the right of PilotCluster (.pilot-cluster left:4 bottom:4 width:248). */
.hot-cross-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
}

.hot-cross {
    position: absolute;
    left: 268px;
    bottom: 36px;
    width: 132px;
    height: 132px;
    background-color: rgba(0, 0, 0, 0);
    overflow: visible;
}

/* Loaded ammo: cutout icon + name above the cross (ammo identity, not the weapon). */
.hot-cross-loaded {
    position: absolute;
    left: 50%;
    top: -34px;
    width: 128px;
    height: 32px;
    margin-left: -64px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
}

.hot-cross-loaded-icon {
    width: 22px;
    height: 22px;
    margin-right: 4px;
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

.hot-cross-loaded-ammo {
    flex-grow: 1;
    flex-shrink: 1;
    height: 24px;
    min-width: 0;
    font-size: 11px;
    color: rgb(255, 194, 61);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: nowrap;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.75);
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Thin gold divider stubs — stop short of the hollow center ring. */
.hot-cross-bar {
    position: absolute;
    background-color: rgb(255, 194, 61);
}

.hot-cross-hbar-l {
    left: 6px;
    top: 50%;
    width: 40px;
    height: 2px;
    margin-top: -1px;
}

.hot-cross-hbar-r {
    right: 6px;
    left: auto;
    top: 50%;
    width: 40px;
    height: 2px;
    margin-top: -1px;
}

.hot-cross-vbar-t {
    top: 6px;
    left: 50%;
    width: 2px;
    height: 40px;
    margin-left: -1px;
}

.hot-cross-vbar-b {
    bottom: 6px;
    top: auto;
    left: 50%;
    width: 2px;
    height: 40px;
    margin-left: -1px;
}

/* Same 40px center as before: dark fill for the clip count + hollow gold ring border. */
.hot-cross-ring {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 40px;
    height: 40px;
    margin-left: -20px;
    margin-top: -20px;
    background-color: rgba(20, 16, 12, 0.72);
    border-width: 2px;
    border-color: rgb(255, 194, 61);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.hot-cross-clip {
    width: 100%;
    height: 100%;
    font-size: 18px;
    color: rgb(255, 194, 61);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0.5px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
}

.hot-cross-quad {
    position: absolute;
    width: 48px;
    height: 48px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    overflow: visible;
}

.hot-cross-q-tl { left: 8px; top: 8px; }
.hot-cross-q-tr { right: 8px; top: 8px; left: auto; }
.hot-cross-q-bl { left: 8px; bottom: 8px; top: auto; }
.hot-cross-q-br { right: 8px; bottom: 8px; left: auto; top: auto; }

.hot-cross-icon-glow {
    left: 0;
    top: -2px;
    right: 0;
    bottom: 8px;
    opacity: 0;
}

.hot-cross-quad--selected {
    border-width: 0;
}

.hot-cross-icon {
    position: absolute;
    left: 4px;
    top: 2px;
    right: 4px;
    bottom: 12px;
    width: auto;
    height: auto;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

/* Mag-only ghost: ammo fully loaded into the magazine, slot stack empty. */
.hot-cross-icon--ghost {
    opacity: 0.55;
}

.hot-cross-amt--ghost {
    color: rgb(255, 194, 61);
    opacity: 0.9;
}

.hot-cross-key {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 12px;
    font-size: 9px;
    color: rgba(255, 194, 61, 0.9);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hot-cross-amt {
    position: absolute;
    right: 2px;
    top: 0;
    font-size: 10px;
    color: rgb(237, 233, 228);
    -unity-font-style: bold;
    -unity-text-align: upper-right;
}

.hot-cross-q-br--reserved {
    opacity: 0.25;
}

/* Ammo load popup — shown/hidden from C# only (do not set display:none here). */
.hot-cross-ammo-popup {
    position: absolute;
    left: 268px;
    bottom: 180px;
    min-width: 200px;
    max-width: 280px;
    padding: 10px 12px;
    background-color: rgba(12, 14, 18, 0.92);
    border-width: 1px;
    border-color: rgb(255, 194, 61);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    flex-direction: column;
}

.hot-cross-ammo-title {
    font-size: 12px;
    color: rgb(255, 194, 61);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    margin-bottom: 2px;
}

.hot-cross-ammo-hint {
    font-size: 9px;
    color: rgba(237, 233, 228, 0.65);
    -unity-text-align: middle-left;
    margin-bottom: 8px;
}

.hot-cross-ammo-list {
    flex-direction: column;
}

.hot-cross-ammo-row {
    flex-direction: row;
    align-items: center;
    min-height: 28px;
    padding: 4px 6px;
    margin-bottom: 2px;
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 1px;
    border-color: rgba(255, 194, 61, 0.25);
}

.hot-cross-ammo-row--selected {
    background-color: rgba(255, 138, 42, 0.22);
    border-color: rgb(255, 194, 61);
}

.hot-cross-ammo-row-label {
    font-size: 11px;
    color: rgb(237, 233, 228);
    -unity-text-align: middle-left;
    flex-grow: 1;
}

/* Level-lock look (loot plan 8.8): same values as the vendor blocked overlay in Vendor.uss. */
.dmg-vendor-block {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(143, 30, 94, 0.55);
}
