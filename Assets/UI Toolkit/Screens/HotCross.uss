/* Hot Cross â€” gold thin cross + hollow center ring; cutout icons (no plate backgrounds).
   Anchored to the right of PilotCluster (.pilot-cluster left:4 bottom:4 width:248). */
.hot-cross-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
}

.hot-cross {
    position: absolute;
    left: 268px;
    bottom: 36px;
    width: 132px;
    height: 132px;
    background-color: rgba(0, 0, 0, 0);
}

.hot-cross-bar {
    position: absolute;
    background-color: rgb(212, 160, 23);
}

/* Four stubs so the gold cross is hollowed out by the center circle. */
.hot-cross-hbar-l {
    left: 8px;
    top: 50%;
    width: 38px;
    height: 3px;
    margin-top: -1.5px;
}

.hot-cross-hbar-r {
    right: 8px;
    left: auto;
    top: 50%;
    width: 38px;
    height: 3px;
    margin-top: -1.5px;
}

.hot-cross-vbar-t {
    top: 8px;
    left: 50%;
    width: 3px;
    height: 38px;
    margin-left: -1.5px;
}

.hot-cross-vbar-b {
    bottom: 8px;
    top: auto;
    left: 50%;
    width: 3px;
    height: 38px;
    margin-left: -1.5px;
}

.hot-cross-ring {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 40px;
    height: 40px;
    margin-left: -20px;
    margin-top: -20px;
    background-color: rgba(47, 47, 47, 0.4);
    border-width: 3px;
    border-color: rgb(212, 160, 23);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.hot-cross-clip {
    width: 100%;
    height: 100%;
    font-size: 18px;
    color: rgb(237, 233, 228);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hot-cross-quad {
    position: absolute;
    width: 48px;
    height: 48px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    overflow: visible;
}

.hot-cross-q-tl { left: 8px; top: 8px; }
.hot-cross-q-tr { right: 8px; top: 8px; left: auto; }
.hot-cross-q-bl { left: 8px; bottom: 8px; top: auto; }
.hot-cross-q-br { right: 8px; bottom: 8px; left: auto; top: auto; }

.hot-cross-icon-glow {
    left: 0;
    top: -2px;
    right: 0;
    bottom: 8px;
    opacity: 0;
}

.hot-cross-quad--selected {
    border-width: 0;
}

.hot-cross-icon {
    position: absolute;
    left: 4px;
    top: 2px;
    right: 4px;
    bottom: 12px;
    width: auto;
    height: auto;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

.hot-cross-key {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 12px;
    font-size: 9px;
    color: rgba(212, 160, 23, 0.85);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hot-cross-amt {
    position: absolute;
    right: 2px;
    top: 0;
    font-size: 10px;
    color: rgb(237, 233, 228);
    -unity-font-style: bold;
    -unity-text-align: upper-right;
}

.hot-cross-q-br--reserved {
    opacity: 0.25;
}

/* Ammo load popup — shown/hidden from C# only (do not set display:none here). */
.hot-cross-ammo-popup {
    position: absolute;
    left: 268px;
    bottom: 180px;
    min-width: 200px;
    max-width: 280px;
    padding: 10px 12px;
    background-color: rgba(12, 14, 18, 0.92);
    border-width: 1px;
    border-color: rgb(212, 160, 23);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    flex-direction: column;
}

.hot-cross-ammo-title {
    font-size: 12px;
    color: rgb(212, 160, 23);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    margin-bottom: 2px;
}

.hot-cross-ammo-hint {
    font-size: 9px;
    color: rgba(237, 233, 228, 0.65);
    -unity-text-align: middle-left;
    margin-bottom: 8px;
}

.hot-cross-ammo-list {
    flex-direction: column;
}

.hot-cross-ammo-row {
    flex-direction: row;
    align-items: center;
    min-height: 28px;
    padding: 4px 6px;
    margin-bottom: 2px;
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 1px;
    border-color: rgba(212, 160, 23, 0.25);
}

.hot-cross-ammo-row--selected {
    background-color: rgba(212, 160, 23, 0.22);
    border-color: rgb(212, 160, 23);
}

.hot-cross-ammo-row-label {
    font-size: 11px;
    color: rgb(237, 233, 228);
    -unity-text-align: middle-left;
    flex-grow: 1;
}