<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="../Themes/DarkMatterGenesis.uss"/>
    <Style src="GameStart.uss"/>
    <ui:VisualElement name="gamestart-root" picking-mode="Position" class="dmg-gs-root">
        <ui:VisualElement name="gamestart-veil" picking-mode="Position" class="dmg-gs-veil"/>
        <ui:VisualElement name="gamestart-panel" picking-mode="Position" class="dmg-gs-panel">
            <ui:Label name="gamestart-title" text="DARK MATTER GENESIS" picking-mode="Ignore" class="dmg-gs-title"/>
            <ui:Label name="gamestart-body" text="Welcome" picking-mode="Ignore" class="dmg-gs-body"/>
            <ui:Button name="gamestart-start" text="START GAME" picking-mode="Position" class="dmg-gs-btn"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
