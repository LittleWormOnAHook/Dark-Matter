<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="../Themes/DarkMatterGenesis.uss"/>
    <Style src="DeathOverlay.uss"/>
    <ui:VisualElement name="death-root" picking-mode="Position" class="dmg-death-root">
        <ui:VisualElement name="death-veil" picking-mode="Position" class="dmg-death-veil"/>
        <ui:VisualElement name="death-panel" picking-mode="Position" class="dmg-death-panel">
            <ui:Label name="death-title" text="GAME OVER" picking-mode="Ignore" class="dmg-death-title"/>
            <ui:Button name="death-retry" text="RETRY" picking-mode="Position" class="dmg-death-btn"/>
            <ui:Button name="death-exit" text="END GAME" picking-mode="Position" class="dmg-death-btn"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
