.dmg-death-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    -unity-font-definition: url("project://database/Assets/Shift%20-%20Complete%20Sci-Fi%20UI/Fonts/Rajdhani-Regular.ttf?fileID=12800000&guid=11524516bb0f95d4ba72a86cdd3756e0&type=3#Rajdhani-Regular");
}

.dmg-death-veil {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.72);
}

.dmg-death-panel {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 520px;
    height: 320px;
    margin-left: -260px;
    margin-top: -160px;
    background-color: rgba(28, 42, 56, 0.98);
    border-width: 1px;
    border-color: rgb(192, 46, 122);
    align-items: center;
    padding: 28px 24px;
}

.dmg-death-title {
    height: 80px;
    font-size: 52px;
    color: rgb(192, 46, 122);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Shift%20-%20Complete%20Sci-Fi%20UI/Fonts/Rajdhani-SemiBold.ttf?fileID=12800000&guid=28b6d07166d6d8947a6671e5480cbf66&type=3#Rajdhani-SemiBold");
}

.dmg-death-btn {
    width: 220px;
    height: 50px;
    margin-top: 16px;
    background-color: rgba(192, 46, 122, 0.95);
    color: rgb(237, 233, 228);
    font-size: 20px;
    -unity-font-style: bold;
}
