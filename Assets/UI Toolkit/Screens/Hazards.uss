.dmg-hz-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    -unity-font-definition: url("project://database/Assets/Shift%20-%20Complete%20Sci-Fi%20UI/Fonts/Rajdhani-Regular.ttf?fileID=12800000&guid=11524516bb0f95d4ba72a86cdd3756e0&type=3#Rajdhani-Regular");
}

.dmg-hz-cluster {
    position: absolute;
    left: 30px;
    bottom: 30px;
    flex-direction: row;
    align-items: flex-end;
}

.dmg-hz-panel {
    width: 318px;
    margin-right: 12px;
    padding: 10px 20px 20px 20px;
    flex-direction: column;
    background-color: rgba(28, 42, 56, 0.9);
    border-width: 1px;
    border-color: rgb(192, 46, 122);
}

.dmg-hz-title {
    height: 18px;
    font-size: 12px;
    color: rgb(237, 233, 228);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.dmg-hz-status {
    height: 16px;
    font-size: 11px;
    color: rgb(237, 233, 228);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.dmg-hz-thermal-track {
    height: 160px;
    margin-top: 8px;
    background-color: rgba(47, 47, 47, 0.95);
    overflow: hidden;
}

.dmg-hz-thermal-fill {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 50%;
    background-color: rgb(192, 46, 122);
}

.dmg-hz-needle {
    position: absolute;
    left: 0;
    width: 100%;
    height: 3px;
    background-color: rgb(237, 233, 228);
}

.dmg-hz-temp {
    height: 22px;
    margin-top: 8px;
    font-size: 20px;
    color: rgb(212, 160, 23);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.dmg-hz-summary-track {
    height: 10px;
    margin-top: 6px;
    background-color: rgba(47, 47, 47, 0.95);
    overflow: hidden;
}

.dmg-hz-summary-fill {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 0;
    background-color: rgb(212, 160, 23);
}

.dmg-hz-muted {
    height: 14px;
    font-size: 11px;
    color: rgb(140, 127, 117);
    -unity-text-align: middle-center;
}

.dmg-hz-rows {
    margin-top: 4px;
    flex-direction: column;
}

.dmg-hz-ticks {
    position: absolute;
    left: 30px;
    bottom: 430px;
    width: 648px;
    min-height: 18px;
}

.dmg-hz-ticks-label {
    font-size: 12px;
    color: rgb(212, 160, 23);
    white-space: normal;
}

.dmg-hz-banner {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 420px;
    height: 92px;
    margin-left: -210px;
    margin-top: -46px;
    background-color: rgba(28, 42, 56, 0.92);
    border-width: 1px;
    border-color: rgb(192, 46, 122);
    align-items: center;
    padding: 12px 16px;
}

.dmg-hz-banner-accent {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 0;
    height: 3px;
    background-color: rgb(192, 46, 122);
}

.dmg-hz-banner-heading {
    margin-top: 10px;
    font-size: 12px;
    color: rgb(140, 127, 117);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.dmg-hz-banner-name {
    font-size: 22px;
    color: rgb(237, 233, 228);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.dmg-hc-row {
    height: 46px;
    margin-bottom: 2px;
    flex-direction: column;
}

.dmg-hc-stat-name {
    height: 16px;
    font-size: 12px;
    color: rgb(237, 233, 228);
    -unity-font-style: bold;
}

.dmg-hc-stat-pct {
    position: absolute;
    right: 0;
    top: 0;
    height: 16px;
    font-size: 12px;
    color: rgb(237, 233, 228);
    -unity-text-align: middle-right;
}

.dmg-hc-segs {
    height: 14px;
    margin-top: 4px;
    flex-direction: row;
}

.dmg-seg {
    flex-grow: 1;
    height: 12px;
    margin-right: 2px;
    background-color: rgba(255, 255, 255, 0.08);
}
