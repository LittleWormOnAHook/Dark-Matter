.dmg-hz-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    -unity-font-definition: url("project://database/Assets/Shift%20-%20Complete%20Sci-Fi%20UI/Fonts/Rajdhani-Regular.ttf?fileID=12800000&guid=11524516bb0f95d4ba72a86cdd3756e0&type=3#Rajdhani-Regular");
}

.dmg-hz-cluster {
    /* Runtime: PinAboveElev() anchors cluster center on ELEV +/- sign, just above ELEV. */
    position: absolute;
    left: 108px;
    bottom: 300px; /* 4 + 290 + 6 */
    margin-left: 0;
    translate: -50% 0;
    flex-direction: column;
    align-items: center;
}

.dmg-hz-panel {
    width: auto;
    min-width: 0;
    margin-right: 0;
    padding: 4px 8px 5px 8px;
    flex-direction: column;
    align-items: center;
    overflow: visible;
    background-color: rgba(20, 30, 40, 0.82);
    border-width: 1px;
    border-color: rgba(212, 160, 23, 0.92); /* palette gold #D4A017 */
    border-radius: 2px;
}

.dmg-hz-thermal {
    width: 44px;
    min-width: 44px;
    max-width: 44px;
    margin-right: 6px;
    padding: 4px 4px 6px 4px;
    align-items: center;
    background-color: rgba(28, 22, 34, 0.78);
    border-width: 1px;
    border-color: rgba(120, 100, 140, 0.5);
}

.dmg-hz-title {
    height: 13px;
    font-size: 9px;
    color: rgb(237, 233, 228);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.dmg-hz-status {
    height: 12px;
    font-size: 9px;
    color: rgb(212, 160, 23);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.dmg-hz-thermal-track {
    width: 12px;
    height: 72px;
    margin-top: 0;
    margin-bottom: 0;
    background-color: rgba(47, 47, 47, 0.95);
    overflow: hidden;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.55);
    -unity-background-scale-mode: stretch-to-fill;
}

.dmg-hz-thermal-fill {
    display: none;
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 0;
    background-color: rgba(0, 0, 0, 0);
}

.dmg-hz-needle {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    margin-bottom: -1px;
    background-color: rgb(237, 233, 228);
}

.dmg-hz-temp {
    height: 14px;
    margin-top: 4px;
    font-size: 11px;
    color: rgb(237, 233, 228);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.dmg-hz-summary-track {
    position: relative;
    flex-grow: 0;
    width: 10px;
    height: 56px;
    margin-top: 2px;
    margin-left: 0;
    background-color: rgba(47, 47, 47, 0.95);
    overflow: hidden;
}

.dmg-hz-summary-fill {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 0;
    background-color: rgb(212, 160, 23);
}

.dmg-hz-muted {
    height: 11px;
    font-size: 9px;
    color: rgb(140, 127, 117);
    -unity-text-align: middle-left;
}

.dmg-hz-rows {
    margin-top: 2px;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: flex-end;
    justify-content: center;
}

.dmg-hz-ticks {
    position: absolute;
    left: 128px;
    bottom: 318px; /* just above hazards chip above ELEV */
    margin-left: 0;
    translate: -50% 0;
    width: 148px;
    min-height: 14px;
    align-items: center;
}

.dmg-hz-ticks-label {
    font-size: 10px;
    color: rgb(212, 160, 23);
    white-space: normal;
}

.dmg-hz-banner {
    position: absolute;
    left: 50%;
    top: 42%;
    width: 280px;
    height: 64px;
    margin-left: -140px;
    margin-top: -32px;
    background-color: rgba(20, 30, 40, 0.9);
    border-width: 1px;
    border-color: rgb(192, 46, 122);
    align-items: center;
    padding: 8px 12px;
}

.dmg-hz-banner-accent {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 0;
    height: 2px;
    background-color: rgb(192, 46, 122);
}

.dmg-hz-banner-heading {
    margin-top: 6px;
    font-size: 10px;
    color: rgb(140, 127, 117);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.dmg-hz-banner-name {
    font-size: 16px;
    color: rgb(237, 233, 228);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.dmg-hc-row {
    width: 34px;
    min-width: 34px;
    height: auto;
    min-height: 78px;
    margin-left: 3px;
    margin-right: 3px;
    margin-bottom: 2px;
    flex-shrink: 0;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
}

.dmg-hc-stat-name {
    width: 34px;
    min-width: 34px;
    height: 12px;
    font-size: 8px;
    color: rgb(237, 233, 228);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.dmg-hc-stat-pct {
    width: 34px;
    min-width: 34px;
    height: 12px;
    margin-left: 0;
    margin-top: 2px;
    font-size: 8px;
    color: rgb(237, 233, 228);
    -unity-text-align: middle-center;
}

.dmg-hc-segs {
    flex-grow: 0;
    width: 10px;
    height: 56px;
    margin-top: 2px;
    margin-left: 0;
    flex-direction: column-reverse;
    align-items: stretch;
}

.dmg-seg {
    flex-grow: 1;
    width: 100%;
    height: auto;
    min-height: 2px;
    margin-right: 0;
    margin-bottom: 1px;
    background-color: rgba(255, 255, 255, 0.08);
}
