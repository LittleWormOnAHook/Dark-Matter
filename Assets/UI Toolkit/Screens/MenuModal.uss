/* Shared full-screen menu sub-panels (Settings, Controls, Save, Wallet). Hide roots in C#. */
.dmg-menu-modal-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
}

.dmg-menu-modal-veil {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.82);
}

.dmg-menu-modal-panel {
    position: absolute;
    left: 5%;
    top: 5%;
    right: 5%;
    bottom: 5%;
    background-color: rgb(28, 42, 56);
    border-width: 1px;
    border-color: rgb(74, 74, 90);
    padding: 24px;
    flex-direction: column;
}

.dmg-menu-modal-title {
    color: rgb(237, 233, 228);
    font-size: 32px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.dmg-menu-modal-body {
    flex-grow: 1;
    margin-bottom: 12px;
}

.dmg-menu-modal-footer {
    flex-direction: row;
    justify-content: flex-end;
}

.dmg-menu-modal-btn {
    min-width: 140px;
    height: 40px;
    margin-left: 10px;
    background-color: rgba(74, 74, 90, 0.75);
    border-color: rgb(212, 160, 23);
    color: rgb(237, 233, 228);
}

.dmg-menu-modal-btn--muted {
    background-color: rgb(47, 47, 47);
    border-color: rgb(74, 74, 90);
}

.dmg-menu-section-title {
    color: rgb(212, 160, 23);
    font-size: 14px;
    -unity-font-style: bold;
    margin-top: 8px;
    margin-bottom: 6px;
}

.dmg-menu-setting-row {
    flex-direction: row;
    align-items: center;
    min-height: 32px;
    margin-bottom: 4px;
}

.dmg-menu-setting-label {
    flex-grow: 1;
    color: rgb(237, 233, 228);
    font-size: 14px;
}

.dmg-menu-setting-value {
    min-width: 48px;
    color: rgb(140, 127, 117);
    -unity-text-align: middle-right;
    font-size: 13px;
}

.dmg-menu-slot-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
    min-height: 72px;
}

.dmg-menu-slot-preview {
    width: 128px;
    height: 72px;
    margin-right: 12px;
    background-color: rgb(30, 30, 34);
    border-width: 1px;
    border-color: rgb(74, 74, 90);
}

.dmg-menu-slot-button {
    flex-grow: 1;
    min-height: 72px;
    background-color: rgba(74, 74, 90, 0.75);
    border-color: rgb(212, 160, 23);
    color: rgb(237, 233, 228);
    -unity-text-align: upper-left;
    padding: 8px 12px;
}

.dmg-menu-tab-bar {
    flex-direction: row;
    margin-bottom: 12px;
}

.dmg-menu-tab {
    min-width: 120px;
    height: 36px;
    margin-right: 8px;
    background-color: rgb(47, 47, 47);
    border-color: rgb(74, 74, 90);
    color: rgb(237, 233, 228);
}

.dmg-menu-tab--active {
    background-color: rgba(74, 74, 90, 0.75);
    border-color: rgb(212, 160, 23);
}

.dmg-menu-scheme-image {
    width: 100%;
    max-height: 520px;
    margin-bottom: 8px;
}

.dmg-menu-scheme-caption {
    color: rgb(140, 127, 117);
    font-size: 13px;
    margin-bottom: 12px;
    white-space: normal;
}
