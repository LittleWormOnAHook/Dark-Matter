.dmg-vendor-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-grow: 1;
}

.dmg-vendor-veil {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(12, 16, 22, 0.72);
}

.dmg-vendor-panel {
    position: absolute;
    left: 4%;
    top: 4%;
    right: 4%;
    bottom: 4%;
    background-color: rgba(28, 42, 56, 0.96);
    border-color: rgb(74, 74, 90);
    border-width: 2px;
    padding: 16px;
    flex-direction: column;
}

.dmg-vendor-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.dmg-section-title,
#vendor-title,
#crate-title {
    color: rgb(212, 160, 23);
    font-size: 28px;
    letter-spacing: 6px;
    -unity-font-style: bold;
}

.dmg-gold-heading,
#crate-player-heading,
#crate-stash-heading,
#vendor-stock-heading,
#vendor-inv-heading,
#vendor-player-ac,
#vendor-npc-ac {
    color: rgb(212, 160, 23);
    font-size: 16px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.dmg-hint,
#crate-hint,
#crate-status,
#vendor-status,
#vendor-qty-label {
    color: rgb(212, 160, 23);
    font-size: 13px;
}

#crate-close,
#vendor-close,
#vendor-ctx-action {
    color: rgb(212, 160, 23);
    background-color: rgb(18, 18, 22);
    border-color: rgb(74, 74, 90);
    border-width: 1px;
    padding: 6px 14px;
}

.dmg-vendor-clock {
    margin-left: 18px;
    color: rgb(212, 160, 23);
    font-size: 14px;
    -unity-font-style: bold;
}

.dmg-vendor-ac-row {
    flex-grow: 1;
    flex-direction: row;
    justify-content: flex-end;
    margin-right: 16px;
}

.dmg-vendor-ac-row > * {
    margin-left: 18px;
}

.dmg-vendor-split {
    flex-grow: 1;
    flex-direction: row;
    padding-top: 8px;
}

.dmg-vendor-col {
    flex-grow: 1;
    flex-basis: 0;
    padding-top: 4px;
}

.dmg-vendor-rule {
    width: 2px;
    flex-shrink: 0;
    align-self: stretch;
    margin-left: 12px;
    margin-right: 12px;
    margin-top: 28px;
    background-color: rgb(212, 160, 23);
}

.dmg-vendor-grid {
    flex-grow: 1;
    min-height: 240px;
    margin-top: 8px;
    padding-top: 12px;
    padding-left: 8px;
    padding-right: 8px;
    padding-bottom: 10px;
    border-width: 1px;
    border-color: rgb(74, 74, 90);
    background-color: rgba(20, 28, 38, 0.55);
}

.dmg-vendor-slot {
    position: relative;
    width: 80px;
    height: 80px;
    margin: 4px;
    flex-grow: 0;
    flex-shrink: 0;
    background-color: rgba(28, 42, 56, 0.92);
    border-width: 1px;
    border-color: rgba(237, 233, 228, 0.28);
    overflow: hidden;
}

.dmg-vendor-slot--focus {
    border-color: rgb(192, 46, 122);
    border-width: 2px;
}

.dmg-vendor-icon {
    position: absolute;
    left: 2px;
    top: 2px;
    right: 2px;
    bottom: 2px;
    width: auto;
    height: auto;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

.dmg-vendor-amount {
    position: absolute;
    right: 3px;
    bottom: 1px;
    color: rgb(212, 160, 23);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.dmg-vendor-block {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(143, 30, 94, 0.55);
}

.dmg-vendor-qty-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 10px;
    min-height: 36px;
}

.dmg-vendor-slider {
    width: 280px;
    margin-left: 12px;
    margin-right: 12px;
}

.dmg-vendor-ctx-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.dmg-vendor-ctx-panel {
    position: absolute;
    width: 160px;
    background-color: rgba(28, 42, 56, 0.96);
    border-color: rgb(74, 74, 90);
    border-width: 1px;
    padding: 6px;
    row-gap: 4px;
}

.dmg-vendor-ctx-btn,
.dmg-vendor-ctx-panel .dmg-fmenu-btn {
    width: 100%;
    height: 34px;
    min-height: 34px;
    margin: 0;
    padding: 0 8px;
    border-width: 1px;
    border-color: rgb(74, 74, 90);
    border-radius: 0;
    background-color: rgb(47, 47, 47);
    color: rgb(212, 160, 23);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.dmg-vendor-ctx-btn:hover,
.dmg-vendor-ctx-panel .dmg-fmenu-btn:hover {
    background-color: rgb(36, 36, 40);
    border-color: rgb(212, 160, 23);
    color: rgb(212, 160, 23);
}
