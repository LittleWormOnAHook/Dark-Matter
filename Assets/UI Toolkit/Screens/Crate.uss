.dmg-crate-header-spacer {
    flex-grow: 1;
}

#crate-title {
    color: rgb(212, 160, 23);
    -unity-font-style: bold;
}

#crate-hint {
    margin-left: 18px;
    color: rgb(212, 160, 23);
}

/* Controller focus on crate / inventory slots (loot plan 8.5, D15). */
.dmg-vendor-slot.dmg-crate-slot.dmg-pad-focus {
    border-color: rgb(192, 46, 122);
    border-width: 2px;
}

#crate-close {
    margin-left: auto;
    color: rgb(212, 160, 23);
    background-color: rgb(18, 18, 22);
    border-color: rgb(74, 74, 90);
    border-width: 1px;
    padding: 6px 14px;
}
