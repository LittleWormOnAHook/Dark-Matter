<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="PilotCluster.uss"/>
    <ui:VisualElement name="pilot-root" picking-mode="Ignore" class="pilot-root">
        <ui:VisualElement name="pilot-cluster" picking-mode="Ignore" class="pilot-cluster">
            <ui:VisualElement name="pilot-energy-block" picking-mode="Ignore" class="pilot-corner-block pilot-energy-block">
                <ui:Label name="pilot-energy-label" text="ENERGY" picking-mode="Ignore" class="pilot-kicker"/>
                <ui:Label name="pilot-energy-value" text="100%" picking-mode="Ignore" class="pilot-stat-value pilot-energy-value"/>
            </ui:VisualElement>
            <ui:VisualElement name="pilot-stamina-block" picking-mode="Ignore" class="pilot-corner-block pilot-stamina-block">
                <ui:Label name="pilot-stamina-label" text="STAMINA" picking-mode="Ignore" class="pilot-kicker"/>
                <ui:Label name="pilot-stamina-value" text="100%" picking-mode="Ignore" class="pilot-stat-value pilot-stamina-value"/>
            </ui:VisualElement>
            <ui:VisualElement name="pilot-o2-block" picking-mode="Ignore" class="pilot-side-block pilot-o2-block">
                <ui:Label name="pilot-o2-icon" text="O2" picking-mode="Ignore" class="pilot-o2-icon"/>
                <ui:Label name="pilot-o2-value" text="100%" picking-mode="Ignore" class="pilot-o2-value"/>
            </ui:VisualElement>
            <ui:VisualElement name="pilot-left-meta" picking-mode="Ignore" class="pilot-meta-col pilot-left-meta">
                <ui:Label name="pilot-load-label" text="LOAD" picking-mode="Ignore" class="pilot-kicker"/>
                <ui:Label name="pilot-load-value" text="0%" picking-mode="Ignore" class="pilot-stat-value"/>
            </ui:VisualElement>
            <ui:VisualElement name="pilot-right-meta" picking-mode="Ignore" class="pilot-meta-col pilot-right-meta">
                <ui:Label name="pilot-elev-legacy" text="ELEV" picking-mode="Ignore" class="pilot-meta-line"/>
            </ui:VisualElement>

            <ui:VisualElement name="pilot-top-meta" picking-mode="Ignore" class="pilot-top-meta">
                <ui:Label name="pilot-elev" text="ELEV +0 M" picking-mode="Ignore" class="pilot-meta-line"/>
                <ui:Label name="pilot-grid" text="GRID 0.00  0.00" picking-mode="Ignore" class="pilot-meta-line"/>
            </ui:VisualElement>

            <ui:VisualElement name="pilot-health" picking-mode="Ignore" class="pilot-health">
                <ui:Label name="pilot-health-label" text="HEALTH" picking-mode="Ignore" class="pilot-kicker"/>
                <ui:VisualElement name="pilot-health-track" picking-mode="Ignore" class="pilot-health-track">
                    <ui:VisualElement name="pilot-health-fill" picking-mode="Ignore" class="pilot-health-fill"/>
                </ui:VisualElement>
                <ui:Label name="pilot-health-value" text="100" picking-mode="Ignore" class="pilot-health-value"/>
            </ui:VisualElement>

            <ui:VisualElement name="pilot-map-stage" picking-mode="Ignore" class="pilot-map-stage">
                <ui:VisualElement name="pilot-arcs" picking-mode="Ignore" class="pilot-arcs"/>
                <ui:VisualElement name="pilot-map-ring" picking-mode="Ignore" class="pilot-map-ring">
                    <ui:VisualElement name="pilot-map-view" picking-mode="Ignore" class="pilot-map-view"/>
                    <ui:VisualElement name="pilot-pois" picking-mode="Ignore" class="pilot-pois"/>
                    <ui:VisualElement name="pilot-map-player" picking-mode="Ignore" class="pilot-map-player"/>
                    <ui:Label name="pilot-cardinal-n" text="N" picking-mode="Ignore" class="pilot-cardinal pilot-cardinal-n"/>
                <ui:Label name="pilot-cardinal-e" text="E" picking-mode="Ignore" class="pilot-cardinal pilot-cardinal-e"/>
                <ui:Label name="pilot-cardinal-s" text="S" picking-mode="Ignore" class="pilot-cardinal pilot-cardinal-s"/>
                <ui:Label name="pilot-cardinal-w" text="W" picking-mode="Ignore" class="pilot-cardinal pilot-cardinal-w"/>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="pilot-temp-gauge" picking-mode="Ignore" class="pilot-temp-gauge">
                <ui:VisualElement name="pilot-temp-track" picking-mode="Ignore" class="pilot-temp-track"/>
                <ui:Label name="pilot-temp" text="70°F" picking-mode="Ignore" class="pilot-temp-value"/>
            </ui:VisualElement>
            <ui:Label name="pilot-zone" text="" picking-mode="Ignore" class="pilot-zone"/>
        </ui:VisualElement>
        <ui:VisualElement name="pilot-compass" picking-mode="Ignore" class="pilot-compass">
            <ui:VisualElement name="pilot-compass-ticks" picking-mode="Ignore" class="pilot-compass-ticks"/>
            <ui:VisualElement name="pilot-compass-line" picking-mode="Ignore" class="pilot-compass-line"/>
            <ui:VisualElement name="pilot-compass-dots" picking-mode="Ignore" class="pilot-compass-dots"/>
            <ui:VisualElement name="pilot-compass-center" picking-mode="Ignore" class="pilot-compass-center"/>
            <ui:Label name="pilot-compass-poi" text="" picking-mode="Ignore" class="pilot-compass-poi"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
