/* DMWorldAmmoHud - world-space mag readout near jetpack / Ammo Count plane */
.dmg-world-ammo-root {
    width: 180px;
    height: 80px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-color: rgba(0, 0, 0, 0);
    justify-content: center;
    align-items: center;
    flex-direction: column;
    overflow: visible;
}

.dmg-world-ammo-count {
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-color: rgba(0, 0, 0, 0);
    color: rgb(107, 199, 122);
    font-size: 56px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    white-space: nowrap;
    -unity-font-definition: url("project://database/Assets/Shift%20-%20Complete%20Sci-Fi%20UI/Fonts/Rajdhani-SemiBold.ttf?fileID=12800000&guid=28b6d07166d6d8947a6671e5480cbf66&type=3#Rajdhani-SemiBold");
    text-shadow: 0 0 12px rgba(107, 199, 122, 0.85);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(20, 40, 24, 0.9);
}
