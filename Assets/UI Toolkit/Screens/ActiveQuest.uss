/* DMUiToolkit 0901-finish */
.dmg-quest-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    -unity-font-definition: url("project://database/Assets/Shift%20-%20Complete%20Sci-Fi%20UI/Fonts/Rajdhani-Regular.ttf?fileID=12800000&guid=11524516bb0f95d4ba72a86cdd3756e0&type=3#Rajdhani-Regular");
}

.dmg-quest-list {
    position: absolute;
    right: 18px;
    top: 210px;
    width: 320px;
    flex-direction: column;
    align-items: flex-end;
}

.dmg-quest-block {
    width: 100%;
    margin-bottom: 8px;
    flex-direction: column;
    align-items: flex-end;
}

.dmg-quest-title {
    font-size: 22px;
    color: rgb(237, 233, 228);
    -unity-font-style: bold;
    -unity-text-align: upper-right;
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Shift%20-%20Complete%20Sci-Fi%20UI/Fonts/Rajdhani-SemiBold.ttf?fileID=12800000&guid=28b6d07166d6d8947a6671e5480cbf66&type=3#Rajdhani-SemiBold");
}

.dmg-quest-title-done {
    color: rgb(212, 160, 23);
}

.dmg-quest-obj {
    margin-top: 1px;
    font-size: 16px;
    color: rgb(237, 233, 228);
    -unity-text-align: upper-right;
    white-space: normal;
}

.dmg-quest-status {
    margin-top: 2px;
    font-size: 14px;
    color: rgb(212, 160, 23);
    -unity-font-style: italic;
    -unity-text-align: upper-right;
}

.dmg-quest-turnin {
    color: rgb(192, 46, 122);
}
