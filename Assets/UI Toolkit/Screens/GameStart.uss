/* DMUiToolkit 0901-finish */
.dmg-gs-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    -unity-font-definition: url("project://database/Assets/Shift%20-%20Complete%20Sci-Fi%20UI/Fonts/Rajdhani-Regular.ttf?fileID=12800000&guid=11524516bb0f95d4ba72a86cdd3756e0&type=3#Rajdhani-Regular");
}

.dmg-gs-veil {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgb(0, 0, 0);
}

.dmg-gs-panel {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 720px;
    height: 520px;
    margin-left: -360px;
    margin-top: -260px;
    padding: 28px 32px;
    background-color: rgba(28, 42, 56, 0.98);
    border-width: 1px;
    border-color: rgb(212, 160, 23);
    align-items: center;
    flex-direction: column;
}

.dmg-gs-title {
    height: 48px;
    font-size: 32px;
    color: rgb(212, 160, 23);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Shift%20-%20Complete%20Sci-Fi%20UI/Fonts/Rajdhani-SemiBold.ttf?fileID=12800000&guid=28b6d07166d6d8947a6671e5480cbf66&type=3#Rajdhani-SemiBold");
}

.dmg-gs-body {
    flex-grow: 1;
    width: 100%;
    margin-top: 12px;
    font-size: 18px;
    color: rgb(237, 233, 228);
    white-space: normal;
    -unity-text-align: upper-left;
}

.dmg-gs-btn {
    width: 260px;
    height: 52px;
    margin-top: 16px;
    background-color: rgba(74, 74, 90, 0.75);
    color: rgb(237, 233, 228);
    font-size: 22px;
    -unity-font-style: bold;
}
