    - target: {fileID: 4160041212382814, guid: 3de2ef7384d527c4b945f960643ef6e2, type: 3}
      propertyPath: m_LocalEulerAnglesHint.y
      value: -90.00001
      objectReference: {fileID: 0}
    - target: {fileID: 4160041212382814, guid: 3de2ef7384d527c4b945f960643ef6e2, type: 3}
